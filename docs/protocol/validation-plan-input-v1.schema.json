{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:maestro:harmonyos:validation-plan-input:1",
  "title": "Validation plan user input v1",
  "$comment": "Structure only. This schema does not establish cross-document identity, original file hashes, command execution, or qualification. See retry-and-validation.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "planId",
    "status",
    "purpose",
    "measurementMode",
    "repeat",
    "runTimeoutSeconds",
    "thresholdPolicy",
    "preparationProcedure",
    "retryPolicy",
    "manualInterventionPolicy",
    "evidencePolicy",
    "devices",
    "profiles",
    "units"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "planId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "status": {
      "const": "frozen"
    },
    "purpose": {
      "enum": [
        "development",
        "formal"
      ]
    },
    "measurementMode": {
      "enum": [
        "per-flow",
        "suite"
      ]
    },
    "repeat": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "runTimeoutSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400
    },
    "thresholdPolicy": {
      "$ref": "#/$defs/thresholdPolicy"
    },
    "preparationProcedure": {
      "type": "string",
      "minLength": 1
    },
    "retryPolicy": {
      "type": "string",
      "minLength": 1
    },
    "manualInterventionPolicy": {
      "const": "review-required"
    },
    "evidencePolicy": {
      "$ref": "#/$defs/evidencePolicy"
    },
    "devices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/device"
      }
    },
    "environmentFingerprint": {
      "description": "Operator-supplied JSON metadata. Recorded, not probed or verified."
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/profile"
      }
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/unit"
      }
    },
    "buildFingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files"
      ],
      "properties": {
        "files": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/fingerprint"
          }
        }
      }
    },
    "applicationFingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files"
      ],
      "properties": {
        "files": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/fingerprint"
          }
        }
      }
    },
    "confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "path",
        "sha256"
      ],
      "properties": {
        "status": {
          "const": "confirmed"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "measurementMode": {
            "const": "per-flow"
          }
        }
      },
      "then": {
        "properties": {
          "units": {
            "items": {
              "properties": {
                "requiredTopLevelFlows": {
                  "maxItems": 1
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "purpose": {
            "const": "formal"
          }
        }
      },
      "then": {
        "required": [
          "confirmation",
          "buildFingerprint",
          "applicationFingerprint"
        ],
        "properties": {
          "buildFingerprint": {
            "properties": {
              "files": {
                "minItems": 1
              }
            }
          },
          "applicationFingerprint": {
            "properties": {
              "files": {
                "minItems": 1
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "absolutePath": {
      "type": "string",
      "pattern": "^(?:[A-Za-z]:[\\\\/]|/|\\\\\\\\)",
      "description": "Absolute path syntax only; containment, existence and links require filesystem checks."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "absoluteFingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?:[A-Za-z]:[\\\\/]|/|\\\\\\\\)",
          "description": "Absolute path syntax only; containment, existence and links require filesystem checks."
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "thresholdPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "minimumRate"
      ],
      "properties": {
        "metric": {
          "enum": [
            "firstPass",
            "finalPass"
          ]
        },
        "minimumRate": {
          "type": "string",
          "pattern": "^(?:0(?:\\.\\d{1,6})?|1(?:\\.0{1,6})?)$"
        }
      }
    },
    "evidencePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requireVideo"
      ],
      "properties": {
        "requireVideo": {
          "type": "boolean"
        },
        "decoderSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "deviceId"
      ],
      "properties": {
        "deviceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
        },
        "matrixInfoSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "batchIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "batchId",
        "unitId",
        "deviceId"
      ],
      "properties": {
        "batchId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "unitId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "deviceId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundleId",
        "abilityName"
      ],
      "properties": {
        "bundleId": {
          "type": "string",
          "minLength": 1
        },
        "abilityName": {
          "type": "string",
          "minLength": 1
        },
        "moduleName": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "environmentNames": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "pattern": "^(?![Aa][Pp][Pp]_[Ii][Dd]$)[A-Za-z_][A-Za-z0-9_]*$"
          },
          "uniqueItems": true
        }
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unitId",
        "profile",
        "entry",
        "sourceRoot",
        "requiredTopLevelFlows"
      ],
      "properties": {
        "unitId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "profile": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "entry": {
          "type": "string",
          "minLength": 1
        },
        "sourceRoot": {
          "type": "string",
          "minLength": 1
        },
        "requiredTopLevelFlows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "name",
              "requiredSteps"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "requiredSteps": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "commandIndex",
                    "role"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "commandIndex": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "role": {
                      "enum": [
                        "action",
                        "assertion"
                      ]
                    }
                  }
                },
                "contains": {
                  "type": "object",
                  "properties": {
                    "role": {
                      "const": "assertion"
                    }
                  },
                  "required": [
                    "role"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
