+++ b/maestro-client/src/main/java/maestro/harmonyos/driver/HarmonyOSDriverConfig.kt
@@ -0,0 +1,39 @@
+package maestro.harmonyos.driver
+
+import java.time.Duration
+
+data class HarmonyOSDriverConfig(
+    val abilityName: String? = null,
+    val moduleName: String? = null,
+    val commandTimeout: Duration = Duration.ofSeconds(15),
+    val settleTimeout: Duration = Duration.ofSeconds(5),
+    val pollInterval: Duration = Duration.ofMillis(100),
+    val enableScreenRecording: Boolean = false,
+    val recordingMaxDuration: Duration = Duration.ofMinutes(3),
+    val recordingStopTimeout: Duration = Duration.ofSeconds(30),
+    val recordingMaxBytes: Long = 512L * 1024 * 1024,
+) {
+    init {
+        for (timeout in listOf(commandTimeout, settleTimeout, pollInterval)) {
+            require(timeout >= Duration.ofMillis(1) && timeout <= Duration.ofMinutes(5)) {
+                "HarmonyOS timeouts must be between 1 ms and 5 minutes"
+            }
+        }
+        require(commandTimeout >= Duration.ofMillis(3)) { "Command timeout must allow capture, transfer and cleanup" }
+        require(recordingMaxDuration in Duration.ofSeconds(1)..Duration.ofMinutes(10)) {
+            "Recording duration must be between 1 second and 10 minutes"
+        }
+        require(recordingStopTimeout in Duration.ofMillis(100)..Duration.ofMinutes(2)) {
+            "Recording stop timeout must be between 100 ms and 2 minutes"
+        }
+        require(recordingMaxBytes in 1024..(1024L * 1024 * 1024)) { "Recording size limit must be between 1 KiB and 1 GiB" }
+        abilityName?.let { requireIdentifier(it, "Ability name") }
+        moduleName?.let { requireIdentifier(it, "Module name") }
+    }
+}
+
+internal fun requireIdentifier(value: String, name: String) {
+    require(value.isNotBlank() && !value.startsWith('-') && value.none { it.isWhitespace() || it == '\u0000' }) {
+        "$name must be non-empty and cannot contain whitespace, NUL, or start with '-'"
+    }
+}
diff --git a/maestro-client/src/main/java/maestro/harmonyos/driver/HarmonyOSSystemScreenRecorder.kt b/maestro-client/src/main/java/maestro/harmonyos/driver/HarmonyOSSystemScreenRecorder.kt
new file mode 100644
index 0000000..d18f2f6
--- /dev/null
+++ b/maestro-client/src/main/java/maestro/harmonyos/driver/HarmonyOSSystemScreenRecorder.kt
@@ -0,0 +1,390 @@
+package maestro.harmonyos.driver
+
+import maestro.ScreenRecording
+import maestro.harmonyos.hdc.HdcException
+import maestro.harmonyos.hdc.HdcTimeoutException
+import maestro.utils.TempFileHandler
+import okio.Buffer
+import okio.Sink
+import java.nio.file.Files
+import java.nio.file.LinkOption
+import java.nio.file.Path
+import java.time.Duration
+import java.time.Instant
+import java.util.UUID
+import java.util.concurrent.ConcurrentHashMap
+import java.util.concurrent.Executors
+import java.util.concurrent.ScheduledExecutorService
+import java.util.concurrent.ScheduledFuture
+import java.util.concurrent.TimeUnit
+
+/**
+ * Optional adapter for Huawei's system recorder. This is not an OpenHarmony shell API.
+ * Commands match DevEco Studio 6.1.1's OpenHarmonyDevice.screenRecord/recvScreenRecord.
+ * The recorder's toggle command requires exclusive use of screen recording on the device.
+ */
+class HarmonyOSSystemScreenRecorder(
+    private val deviceId: String,
+    private val device: HarmonyOSDevice,
+    private val receiveFile: (String, Path, Duration) -> Unit,
+    private val config: HarmonyOSDriverConfig,
+) {
+    fun start(out: Sink): ScreenRecording {
+        check(config.enableScreenRecording) { "System screen recording must be explicitly enabled" }
+        if (!leases.add(deviceId)) throw HdcException("Another Maestro recording owns this device")
+        val recording = Recording(out)
+        try {
+            recording.start()
+            return recording
+        } catch (error: Throwable) {
+            recording.abortStart(error)
+            throw error
+        }
+    }
+
+    private inner class Recording(private val out: Sink) : ScreenRecording {
+        private val fileName = "maestro-recording-${UUID.randomUUID().toString().replace("-", "")}.mp4"
+        private val remotePath = "/data/local/tmp/$fileName"
+        private val files = TempFileHandler()
+        private var localDirectory: Path? = null
+        private var localPath: Path? = null
+        private var ownerPid: Int? = null
+        private var startSent = false
+        private var startConfirmed = false
+        private var stopSent = false
+        private var closed = false
+        private var failure: Throwable? = null
+        private var timer: ScheduledExecutorService? = null
+        private var deadlineTask: ScheduledFuture<*>? = null
+        private var lastIncomplete: HdcException? = null
+        private var validatedSize: Long? = null
+        override lateinit var startedAt: Instant
+            private set
+
+        fun start() {
+            val budget = Budget(config.commandTimeout)
+            val bundle = command(listOf("bm", "dump", "-n", BUNDLE), budget)
+            if (!bundle.contains(ABILITY)) throw UnsupportedOperationException("Huawei system screen recorder is not available")
+            if (processes(budget).isNotEmpty() || captureInstances(budget).isNotEmpty()) {
+                throw HdcException("A screen recorder process or capture session already exists; leave it under its owner's control")
+            }
+            if (query(budget) != null) throw HdcException("The generated recording name already exists")
+            localDirectory = files.createTempDirectory("maestro-harmonyos-recording-").toPath()
+            localPath = localDirectory!!.resolve(fileName)
+            startSent = true
+            aa(listOf("--ps", "CustomizedFileName", fileName), budget)
+            startConfirmed = true
+            while (true) {
+                val pids = processes(budget)
+                val captures = captureInstances(budget)
+                if (pids.size > 1 || captures.size > 1) throw HdcException("Recording ownership is ambiguous")
+                val pid = pids.singleOrNull()
+                if (pid != null && captures == setOf(pid)) {
+                    ownerPid = pid
+                    startedAt = Instant.now()
+                    break
+                }
+                pause(budget)
+            }
+            val executor = Executors.newSingleThreadScheduledExecutor { task ->
+                Thread(task, "maestro-harmonyos-recording-limit").apply { isDaemon = true }
+            }
+            timer = executor
+            deadlineTask = executor.schedule({ expire() }, config.recordingMaxDuration.toMillis(), TimeUnit.MILLISECONDS)
+        }
+
+        private fun expire() {
+            synchronized(this) {
+                if (closed) return
+                val limit = HdcException("Recording reached its ${config.recordingMaxDuration.toSeconds()} second limit")
+                try {
+                    close()
+                    failure = limit
+                } catch (error: Throwable) {
+                    error.addSuppressed(limit)
+                }
+            }
+        }
+
+        @Synchronized
+        override fun close() {
+            if (closed) {
+                failure?.let { throw it }
+                return
+            }
+            closed = true
+            deadlineTask?.cancel(false)
+            timer?.shutdown()
+            timer = null
+            val interrupted = Thread.interrupted()
+            var primary: Throwable? = null
+            try {
+                finish(Budget(config.recordingStopTimeout))
+            } catch (error: Throwable) {
+                primary = error
+                if (error is HdcTimeoutException) lastIncomplete?.let(error::addSuppressed)
+                stopAfterFailure(error)
+            } finally {
+                primary = cleanup(primary)
+                leases.remove(deviceId)
+                if (interrupted || primary is InterruptedException) Thread.currentThread().interrupt()
+            }
+            failure = primary
+            primary?.let(::addRecoveryHint)
+            primary?.let { throw it }
+        }
+
+        fun abortStart(original: Throwable) {
+            val interrupted = Thread.interrupted()
+            closed = true
+            deadlineTask?.cancel(false)
+            timer?.shutdown()
+            try {
+                if (startConfirmed) {
+                    val budget = Budget(config.recordingStopTimeout)
+                    val pids = processes(budget)
+                    val captures = captureInstances(budget)
+                    val pid = pids.singleOrNull()
+                    if (pid != null && captures == setOf(pid)) {
+                        ownerPid = pid
+                        finish(budget)
+                    } else {
+                        original.addSuppressed(HdcException("Could not confirm ownership after recording start; check the device for $fileName"))
+                    }
+                } else if (startSent) {
+                    original.addSuppressed(HdcException("Recording start was not acknowledged; no stop toggle was sent. Check the device for $fileName"))
+                }
+            } catch (error: Throwable) {
+                if (error !== original) original.addSuppressed(error)
+                stopAfterFailure(original)
+            } finally {
+                cleanup(original)
+                if (startSent) addRecoveryHint(original)
+                leases.remove(deviceId)
+                if (interrupted || original is InterruptedException) Thread.currentThread().interrupt()
+            }
+        }
+
+        private fun finish(budget: Budget) {
+            var uri = query(budget)
+            var complete = uri?.let { exportIfComplete(it, budget) } ?: false
+            if (!complete) {
+                // The system publishes an asset while it is still recording. Only a
+                // finalized MP4, not URI presence alone, proves that it has finished.
+                stopIfOwned(budget)
+                while (!complete) {
+                    pause(budget)
+                    uri = query(budget)
+                    complete = uri?.let { exportIfComplete(it, budget) } ?: false
+                }
+            }
+            copyToSink(budget)
+            val ownedUri = checkNotNull(uri)
+            val deletion = command(listOf("mediatool", "delete", ownedUri), budget)
+            if (deletion.trim() != "[SUCCESS] delete success.") {
+                throw HdcException("The recording was exported but mediatool did not confirm deletion: $deletion")
+            }
+            if (query(budget) != null) throw HdcException("The recording was exported but its media asset was not deleted: $ownedUri")
+        }
+
+        private fun stopIfOwned(budget: Budget) {
+            val pid = ownerPid ?: throw HdcException("This session has no confirmed recording process")
+            val pids = processes(budget)
+            val captures = captureInstances(budget)
+            if ((pids.isNotEmpty() && pids != setOf(pid)) || (captures.isNotEmpty() && captures != setOf(pid))) {
+                throw HdcException("The recording process or capture session changed; refusing to toggle another recording")
+            }
+            if (pid in pids && captures == setOf(pid)) {
+                // Set this before sending: a lost reply cannot cause a second toggle.
+                check(!stopSent) { "A recording stop request has already been sent" }
+                stopSent = true
+                aa(emptyList(), budget)
+            }
+        }
+
+        private fun stopAfterFailure(original: Throwable) {
+            if (stopSent || ownerPid == null || validatedSize != null) return
+            val interrupted = Thread.interrupted()
+            try {
+                val budget = Budget(Duration.ofSeconds(2))
+                query(budget) // Reject malformed or ambiguous asset responses before a toggle.
+                stopIfOwned(budget)
+            } catch (error: Throwable) {
+                if (error !== original) original.addSuppressed(error)
+            } finally {
+                if (interrupted) Thread.currentThread().interrupt()
+            }
+        }
+
+        private fun exportIfComplete(uri: String, budget: Budget): Boolean {
+            val path = checkNotNull(localPath)
+            command(listOf("rm", "-f", remotePath), budget)
+            val output = try {
+                command(listOf("mediatool", "recv", uri, remotePath), budget)
+            } catch (error: HarmonyOSCommandException) {
+                if (error.remoteExitCode == 0 && error.stderr.isEmpty() &&
+                    error.stdout.trim().lines() == listOf("Table Name: Photos", "[FAIL] open source media file failed.")
+                ) {
+                    lastIncomplete = error
+                    return false
+                }
+                throw error
+            }
+            if (output.lineSequence().map { it.trim() }.filter { it.isNotEmpty() }.toList() != listOf("Table Name: Photos", remotePath)) {
+                throw HdcException("mediatool did not confirm the requested recording export: $output")
+            }
+            val sizeOutput = command(listOf("stat", "-c", "%s", remotePath), budget).trim()
+            val size = sizeOutput.toLongOrNull() ?: throw HdcException("Invalid recording size returned by stat: $sizeOutput")
+            if (size > config.recordingMaxBytes || size < 0) throw HdcException("Recording exceeds the configured ${config.recordingMaxBytes} byte limit")
+            if (size == 0L) return false
+            Files.deleteIfExists(path)
+            receiveFile(remotePath, path, budget.remaining())
+            if (!Files.isRegularFile(path, LinkOption.NOFOLLOW_LINKS) || Files.size(path) != size) {
+                throw HdcException("Recording transfer did not produce the expected file size")
+            }
+            return try {
+                Mp4RecordingValidator.validate(path, config.recordingMaxBytes)
+                validatedSize = size
+                true
+            } catch (error: InvalidMp4RecordingException) {
+                lastIncomplete = error
+                false
+            }
+        }
+
+        private fun addRecoveryHint(error: Throwable) {
+            error.addSuppressed(HdcException("Recording may remain on the device. Recover only this session's file with: mediatool query $fileName -u"))
+        }
+
+        private fun copyToSink(budget: Budget) {
+            val expected = checkNotNull(validatedSize)
+            var copied = 0L
+            Files.newInputStream(checkNotNull(localPath), LinkOption.NOFOLLOW_LINKS).use { input ->
+                val bytes = ByteArray(64 * 1024)
+                while (true) {
+                    budget.remaining()
+                    val count = input.read(bytes)
+                    if (count < 0) break
+                    copied += count
+                    if (copied > expected || copied > config.recordingMaxBytes) throw HdcException("Recording changed after validation")
+                    val buffer = Buffer().write(bytes, 0, count)
+                    out.write(buffer, count.toLong())
+                }
+            }
+            if (copied != expected || Files.size(checkNotNull(localPath)) != expected) throw HdcException("Recording changed after validation")
+            out.flush()
+        }
+
+        private fun query(budget: Budget): String? {
+            val output = try {
+                command(listOf("mediatool", "query", fileName, "-u"), budget)
+            } catch (error: HarmonyOSCommandException) {
+                // mediatool uses 255 for an exact no-match result on the supported device.
+                if (error.remoteExitCode == 255 && error.stdout.trim() == "find 0 result" && error.stderr.isEmpty()) {
+                    return null
+                }
+                throw error
+            }
+            val lines = output.lineSequence().map { it.trim() }.filter { it.isNotEmpty() }.toList()
+            if (lines == listOf("find 0 result")) return null
+            if (lines.size != 3 || lines[0] != "find 1 result" || lines[1] != "uri") {
+                throw HdcException("Unexpected result while querying the recording's unique name: $output")
+            }
+            val value = lines[2]
+            if (!value.startsWith('"') || !value.endsWith('"')) throw HdcException("Recording URI was not quoted")
+            val uri = value.substring(1, value.length - 1)
+            val expected = Regex("file://media/Photo/[0-9]+/[A-Za-z0-9_.-]+/${Regex.escape(fileName)}")
+            if (!expected.matches(uri)) throw HdcException("Media query returned an unexpected recording URI")
+            return uri
+        }
+
+        private fun aa(extra: List<String>, budget: Budget) {
+            val output = command(listOf("aa", "start", "-b", BUNDLE, "-a", ABILITY) + extra, budget)
+            if (output.lineSequence().none { it.trim() == "start ability successfully." }) {
+                throw HdcException("System recorder ability did not confirm success: $output")
+            }
+        }
+
+        private fun cleanup(original: Throwable?): Throwable? {
+            var result = original
+            fun record(error: Throwable) {
+                if (result == null) result = error else if (result !== error) result!!.addSuppressed(error)
+            }
+            if (localPath != null) {
+                if (Thread.currentThread().isInterrupted) {
+                    record(HdcException("Recording scratch cleanup interrupted; temporary file may remain at $remotePath"))
+                } else {
+                    try {
+                        device.execute(listOf("rm", "-f", remotePath), Duration.ofSeconds(2))
+                    } catch (error: Throwable) {
+                        record(error)
+                    }
+                }
+            }
+            for (path in listOfNotNull(localPath, localDirectory)) {
+                try { Files.deleteIfExists(path) } catch (error: Exception) { record(error) }
+            }
+            try { files.close() } catch (error: Exception) { record(error) }
+            return result
+        }
+    }
+
+    private fun command(arguments: List<String>, budget: Budget): String = device.execute(arguments, budget.remaining())
+
+    private fun processes(budget: Budget): Set<Int> {
+        val output = command(listOf("ps", "-ef"), budget)
+        val lines = output.lineSequence().map { it.trim() }.filter { it.isNotEmpty() }.toList()
+        val header = lines.firstOrNull()?.split(Regex("\\s+"))
+        if (header != listOf("UID", "PID", "PPID", "C", "STIME", "TTY", "TIME", "CMD")) {
+            throw HdcException("Cannot recognize the device process listing; recording ownership cannot be checked")
+        }
+        return lines.drop(1).mapNotNull { line ->
+            val columns = line.split(Regex("\\s+"), limit = 8)
+            if (columns.size != 8) throw HdcException("Invalid device process row")
+            if (columns[7] == BUNDLE || columns[7].startsWith("$BUNDLE:")) {
+                columns[1].toIntOrNull()?.takeIf { it > 0 } ?: throw HdcException("Invalid system recorder PID")
+            } else null
+        }.toSet()
+    }
+
+    private fun captureInstances(budget: Budget): Set<Int> {
+        val output = command(listOf("hidumper", "-s", "3002", "-a", "-h"), budget)
+        val marker = "--ScreenCaptureServer--:"
+        if (!output.contains("PlayerDistributedService") || output.split(marker).size != 2) {
+            throw HdcException("Cannot recognize system capture status; recording ownership cannot be checked")
+        }
+        val tail = output.substringAfter(marker)
+        val nextSection = Regex("(?m)^-{2,}[A-Za-z]").find(tail)
+            ?: throw HdcException("System capture status is incomplete")
+        val entries = tail.substring(0, nextSection.range.first)
+        val pattern = Regex("-----#[0-9]+: pid = ([0-9]+)-----")
+        if (pattern.replace(entries, "").isNotBlank()) throw HdcException("Unexpected system capture instance format")
+        return pattern.findAll(entries).map { match ->
+            match.groupValues[1].toIntOrNull()?.takeIf { it > 0 } ?: throw HdcException("Invalid capture instance PID")
+        }.toSet()
+    }
+
+    private fun pause(budget: Budget) {
+        val nanos = minOf(config.pollInterval, budget.remaining()).toNanos()
+        try { Thread.sleep(nanos / 1_000_000, (nanos % 1_000_000).toInt()) } catch (error: InterruptedException) {
+            Thread.currentThread().interrupt()
+            throw error
+        }
+    }
+
+    private inner class Budget(private val duration: Duration) {
+        private val deadline = System.nanoTime() + duration.toNanos()
+        fun remaining(): Duration {
+            if (Thread.currentThread().isInterrupted) throw InterruptedException("Screen recording interrupted")
+            val left = deadline - System.nanoTime()
+            if (left <= 0) throw HdcTimeoutException(duration)
+            return minOf(config.commandTimeout, Duration.ofNanos(left))
+        }
+    }
+
+    private companion object {
+        const val BUNDLE = "com.huawei.hmos.screenrecorder"
+        const val ABILITY = "$BUNDLE.ServiceExtAbility"
+        val leases = ConcurrentHashMap.newKeySet<String>()
+    }
+}
diff --git a/maestro-client/src/main/java/maestro/harmonyos/driver/HdcHarmonyOSDevice.kt b/maestro-client/src/main/java/maestro/harmonyos/driver/HdcHarmonyOSDevice.kt
new file mode 100644
index 0000000..262e1d9
--- /dev/null
+++ b/maestro-client/src/main/java/maestro/harmonyos/driver/HdcHarmonyOSDevice.kt
@@ -0,0 +1,187 @@
+package maestro.harmonyos.driver
+
+import maestro.TreeNode
+import maestro.ScreenRecording
+import okio.Sink
+import maestro.harmonyos.hdc.HdcClient
+import maestro.harmonyos.hdc.HdcCommandException
+import maestro.harmonyos.hdc.HdcException
+import maestro.harmonyos.hdc.HdcTimeoutException
+import maestro.harmonyos.layout.HierarchyReader
+import maestro.utils.TempFileHandler
+import java.nio.file.Files
+import java.nio.file.LinkOption
+import java.nio.file.Path
+import java.time.Duration
+import java.util.UUID
+
+class HarmonyOSCommandException(
+    message: String,
+    val stdout: String,
+    val stderr: String,
+    val remoteExitCode: Int? = null,
+    cause: Throwable? = null,
+) : HdcException("$message\n${stdout.trim()}\n${stderr.trim()}".trim(), cause)
+
+/**
+ * UITest command reference:
+ * https://github.com/openharmony/testfwk_arkxtest/blob/f59296c77aac5037a9335c317af58de3a0c22ecb/uitest/server/server_main.cpp
+ */
+class HdcHarmonyOSDevice(
+    private val deviceId: String,
+    private val hdc: HdcClient = HdcClient(),
+) : HarmonyOSDevice {
+    override fun connect() {
+        hdc.selectDevice(deviceId)
+    }
+
+    override fun isAvailable(): Boolean = deviceId in hdc.listDevices()
+
+    override fun startScreenRecording(out: Sink, config: HarmonyOSDriverConfig): ScreenRecording =
+        HarmonyOSSystemScreenRecorder(deviceId, this, { remote, local, timeout ->
+            hdc.receiveFile(deviceId, remote, local, timeout)
+        }, config).start(out)
+
+    override fun hierarchy(timeout: Duration): TreeNode {
+        return HierarchyReader(
+            hdc, deviceId,
+            commandTimeout = timeout,
+            cleanupTimeout = Duration.ofSeconds(2),
+            totalTimeout = timeout,
+        ).read()
+    }
+
+    override fun execute(arguments: List<String>, timeout: Duration): String {
+        checkInterrupted()
+        require(arguments.isNotEmpty()) { "A device command is required" }
+        val marker = "MAESTRO_EXIT_${UUID.randomUUID().toString().replace("-", "")}="
+        val script = arguments.joinToString(" ") { HdcClient.quoteShellArgument(it) } +
+            "; __maestro_status=\$?; printf '\\n${marker}%s\\n' \"\$__maestro_status\"; exit \"\$__maestro_status\""
+        var transportFailure: HdcCommandException? = null
+        val result = try {
+            hdc.shell(deviceId, listOf("sh", "-c", script), timeout)
+        } catch (error: HdcCommandException) {
+            // HDC's text heuristic can identify a remote tool's [FAIL] output as a
+            // transport error. Only this invocation's final status proves it ran.
+            if (error.result.exitCode != 0 || remoteStatus(error.result.stdout, marker) == null) throw error
+            transportFailure = error
+            error.result
+        }
+        checkInterrupted()
+        val lines = result.stdout.trimEnd().lines()
+        val status = remoteStatus(result.stdout, marker)
+            ?: throw HarmonyOSCommandException(
+                "Device command did not return its exit status", result.stdout, result.stderr,
+            )
+        val output = lines.dropLast(1).joinToString("\n").trimEnd()
+        if (status != 0) {
+            throw HarmonyOSCommandException("Device command failed (exit $status)", output, result.stderr, status, transportFailure)
+        }
+        if (DEVICE_FAILURE.containsMatchIn(output) || DEVICE_FAILURE.containsMatchIn(result.stderr)) {
+            throw HarmonyOSCommandException("Device command reported a failure", output, result.stderr, status, transportFailure)
+        }
+        // ui_input.cpp returns EXIT_SUCCESS even for an ApiCallErr. Its successful message is
+        // defined as "No Error" in uitest/core/frontend_error_defines.h at the revision above.
+        if (arguments.take(2) == listOf("uitest", "uiInput") &&
+            (output.trim() != "No Error" || result.stderr.isNotBlank())
+        ) {
+            throw HarmonyOSCommandException("UITest did not confirm input success", output, result.stderr, status, transportFailure)
+        }
+        return output
+    }
+
+    private fun remoteStatus(stdout: String, marker: String): Int? {
+        val lastLine = stdout.trimEnd().lineSequence().lastOrNull().orEmpty()
+        return lastLine.takeIf { it.startsWith(marker) }?.removePrefix(marker)?.toIntOrNull()
+    }
+
+    override fun screenshot(timeout: Duration): ByteArray {
+        checkInterrupted()
+        require(!timeout.isZero && !timeout.isNegative) { "Screenshot timeout must be positive" }
+        val deadline = System.nanoTime() + timeout.toNanos()
+        val remotePath = "/data/local/tmp/maestro-screen-${UUID.randomUUID()}.png"
+        val files = TempFileHandler()
+        var localDirectory: Path? = null
+        var localPath: Path? = null
+        var captureAttempted = false
+        var failure: Throwable? = null
+        try {
+            localDirectory = files.createTempDirectory("maestro-harmonyos-screen-").toPath()
+            localPath = localDirectory.resolve("screen.png")
+            captureAttempted = true
+            execute(listOf("uitest", "screenCap", "-p", remotePath), remainingBudget(deadline, timeout))
+            hdc.receiveFile(deviceId, remotePath, localPath, remainingBudget(deadline, timeout))
+            checkInterrupted()
+            if (!Files.isRegularFile(localPath, LinkOption.NOFOLLOW_LINKS)) {
+                throw HdcException("HDC did not create the requested screenshot file")
+            }
+            val size = Files.size(localPath)
+            if (size !in 1..MAX_SCREENSHOT_BYTES.toLong()) throw HdcException("Screenshot file exceeds its size limit or is empty")
+            val bytes = Files.newInputStream(localPath).use { it.readNBytes(MAX_SCREENSHOT_BYTES + 1) }
+            if (bytes.size.toLong() != size || Files.size(localPath) != size) {
+                throw HdcException("Screenshot file changed while it was being read")
+            }
+            remainingBudget(deadline, timeout)
+            return bytes
+        } catch (error: Throwable) {
+            failure = error
+            if (error is InterruptedException) Thread.currentThread().interrupt()
+            throw error
+        } finally {
+            val errors = mutableListOf<Throwable>()
+            if (captureAttempted) {
+                if (Thread.currentThread().isInterrupted) {
+                    errors += HdcException("Device cleanup skipped after interruption; temporary screenshot may remain at $remotePath")
+                } else {
+                    try {
+                        // Cleanup has its own small allowance even when the capture budget expired.
+                        execute(listOf("rm", "-f", remotePath), Duration.ofSeconds(2))
+                    } catch (error: Throwable) {
+                        if (error is InterruptedException) {
+                            Thread.currentThread().interrupt()
+                            error.addSuppressed(HdcException("Temporary screenshot may remain at $remotePath"))
+                            errors += error
+                        } else {
+                            errors += HdcException("Could not remove temporary screenshot $remotePath: ${error.message}", error)
+                        }
+                    }
+                }
+            }
+            for (path in listOfNotNull(localPath, localDirectory)) {
+                try {
+                    Files.deleteIfExists(path)
+                } catch (error: Exception) {
+                    errors += error
+                }
+            }
+            files.close()
+            if (errors.isNotEmpty()) {
+                val original = failure
+                if (original != null) {
+                    errors.forEach(original::addSuppressed)
+                } else {
+                    val cleanupFailure = errors.firstOrNull { it is InterruptedException }
+                        ?: HdcException("Could not clean up temporary screenshot $remotePath")
+                    errors.filter { it !== cleanupFailure }.forEach(cleanupFailure::addSuppressed)
+                    throw cleanupFailure
+                }
+            }
+        }
+    }
+
+    private fun remainingBudget(deadline: Long, timeout: Duration): Duration {
+        checkInterrupted()
+        val remaining = deadline - System.nanoTime()
+        if (remaining <= 0) throw HdcTimeoutException(timeout)
+        return Duration.ofNanos(remaining)
+    }
+
+    private fun checkInterrupted() {
+        if (Thread.currentThread().isInterrupted) throw InterruptedException("HarmonyOS operation interrupted")
+    }
+
+    private companion object {
+        const val MAX_SCREENSHOT_BYTES = 32 * 1024 * 1024
+        val DEVICE_FAILURE = Regex("(?im)^\\s*(?:ScreenCap failed:|DumpLayout failed:|\\[\\s*(?:fail|error)\\s*]|error:|failed:)")
+    }
+}
diff --git a/maestro-client/src/main/java/maestro/harmonyos/driver/Mp4RecordingValidator.kt b/maestro-client/src/main/java/maestro/harmonyos/driver/Mp4RecordingValidator.kt
new file mode 100644
index 0000000..b7ea2b2
--- /dev/null
+++ b/maestro-client/src/main/java/maestro/harmonyos/driver/Mp4RecordingValidator.kt
@@ -0,0 +1,207 @@
+package maestro.harmonyos.driver
+
+import maestro.harmonyos.hdc.HdcException
+import java.nio.ByteBuffer
+import java.nio.ByteOrder
+import java.nio.channels.FileChannel
+import java.nio.file.Files
+import java.nio.file.LinkOption
+import java.nio.file.Path
+import java.nio.file.StandardOpenOption
+import java.nio.file.attribute.BasicFileAttributes
+
+class InvalidMp4RecordingException(message: String) : HdcException("Invalid MP4 recording: $message")
+
+/** Checks a finalized ISO BMFF recording's structure, not whether its compressed frames decode. */
+object Mp4RecordingValidator {
+    fun validate(path: Path, maxBytes: Long) {
+        require(maxBytes > 0) { "Recording size limit must be positive" }
+        if (Thread.currentThread().isInterrupted) throw InterruptedException("MP4 validation interrupted")
+        val before = Files.readAttributes(path, BasicFileAttributes::class.java, LinkOption.NOFOLLOW_LINKS)
+        if (!before.isRegularFile || before.isSymbolicLink) invalid("a regular file without symlinks is required")
+        val size = before.size()
+        if (size <= 0 || size > maxBytes) invalid("file must contain between 1 and $maxBytes bytes")
+        FileChannel.open(path, StandardOpenOption.READ, LinkOption.NOFOLLOW_LINKS).use { channel ->
+            if (channel.size() != size) invalid("file changed before validation")
+            Reader(channel, size).validate()
+            if (channel.size() != size) invalid("file changed during validation")
+        }
+        val after = Files.readAttributes(path, BasicFileAttributes::class.java, LinkOption.NOFOLLOW_LINKS)
+        if (!after.isRegularFile || after.isSymbolicLink || after.size() != size ||
+            after.lastModifiedTime() != before.lastModifiedTime() ||
+            (before.fileKey() != null && after.fileKey() != before.fileKey())
+        ) {
+            invalid("file changed during validation")
+        }
+    }
+
+    private class Reader(private val channel: FileChannel, private val fileSize: Long) {
+        private var boxCount = 0
+        private var hasFileType = false
+        private var hasMovie = false
+        private var hasMediaData = false
+        private val tracks = mutableListOf<Track>()
+
+        fun validate() {
+            boxes(0, fileSize, "file", null, 0)
+            if (!hasFileType) invalid("missing ftyp box")
+            if (!hasMovie) invalid("missing moov box; recording may not be finalized")
+            if (!hasMediaData) invalid("missing non-empty mdat box")
+            if (tracks.none { it.handler == "vide" && it.positiveDuration == true && it.positiveDimensions == true }) {
+                invalid("no video track with positive duration, timescale and dimensions")
+            }
+        }
+
+        private fun boxes(start: Long, end: Long, parent: String, track: Track?, depth: Int) {
+            if (depth > MAX_DEPTH) invalid("box nesting exceeds $MAX_DEPTH levels")
+            var position = start
+            while (position < end) {
+                if (Thread.currentThread().isInterrupted) throw InterruptedException("MP4 validation interrupted")
+                if (++boxCount > MAX_BOXES) invalid("box count exceeds $MAX_BOXES")
+                val box = box(position, end, parent)
+                when (box.type) {
+                    "ftyp" -> {
+                        if (parent != "file" || hasFileType) invalid("misplaced or duplicate ftyp box")
+                        if (box.payloadSize < 8 || box.payloadSize % 4 != 0L) invalid("malformed ftyp payload")
+                        hasFileType = true
+                    }
+                    "moov" -> {
+                        if (parent != "file" || hasMovie) invalid("misplaced or duplicate moov box")
+                        hasMovie = true
+                        boxes(box.payload, box.end, box.type, null, depth + 1)
+                    }
+                    "mdat" -> {
+                        if (parent != "file") invalid("misplaced mdat box")
+                        hasMediaData = hasMediaData || box.payloadSize > 0
+                    }
+                    "trak" -> {
+                        if (parent != "moov") invalid("trak must be a direct child of moov")
+                        val current = Track()
+                        tracks += current
+                        boxes(box.payload, box.end, box.type, current, depth + 1)
+                    }
+                    "mdia" -> {
+                        if (parent != "trak" || track == null || track.hasMedia) invalid("misplaced or duplicate mdia box")
+                        track.hasMedia = true
+                        boxes(box.payload, box.end, box.type, track, depth + 1)
+                    }
+                    "tkhd" -> {
+                        if (parent != "trak" || track == null || track.positiveDimensions != null) {
+                            invalid("misplaced or duplicate tkhd box")
+                        }
+                        track.positiveDimensions = dimensions(box)
+                    }
+                    "mdhd" -> {
+                        if (parent != "mdia" || track == null || track.positiveDuration != null) {
+                            invalid("misplaced or duplicate mdhd box")
+                        }
+                        track.positiveDuration = duration(box)
+                    }
+                    "hdlr" -> {
+                        if (parent == "mdia") {
+                            if (track == null || track.handler != null) invalid("duplicate media handler")
+                            if (box.payloadSize < 24) invalid("truncated hdlr box")
+                            track.handler = typeAt(box.payload + 8)
+                        }
+                    }
+                    "meta" -> {
+                        if (box.payloadSize < 4) invalid("truncated meta full-box header")
+                        boxes(box.payload + 4, box.end, box.type, track, depth + 1)
+                    }
+                    in CONTAINERS -> boxes(box.payload, box.end, box.type, track, depth + 1)
+                }
+                position = box.end
+            }
+        }
+
+        private fun box(position: Long, parentEnd: Long, parent: String): Box {
+            if (parentEnd - position < 8) invalid("truncated box header at $position")
+            val header = read(position, 8)
+            val size32 = header.int.toLong() and UINT32_MAX
+            val typeBytes = ByteArray(4).also { header.get(it) }
+            val type = String(typeBytes, Charsets.ISO_8859_1)
+            var headerSize = 8L
+            val size = when (size32) {
+                0L -> {
+                    // The zero-size form extends to EOF, not to an arbitrary container boundary.
+                    if (parent != "file") invalid("zero-size nested box at $position")
+                    fileSize - position
+                }
+                1L -> {
+                    if (parentEnd - position < 16) invalid("truncated extended box header at $position")
+                    headerSize = 16
+                    read(position + 8, 8).long.also {
+                        if (it < 0) invalid("box size exceeds the signed file offset range")
+                    }
+                }
+                else -> size32
+            }
+            if (size < headerSize || size > parentEnd - position) invalid("box $type exceeds its parent or has an invalid size")
+            // The subtraction checks above make both additions safe from signed overflow.
+            return Box(type, position + headerSize, position + size)
+        }
+
+        private fun duration(box: Box): Boolean {
+            val version = version(box)
+            val required = if (version == 0) 24 else 36
+            if (box.payloadSize < required) invalid("truncated mdhd box")
+            val offset = box.payload + if (version == 0) 12 else 20
+            val timeScale = unsignedInt(offset)
+            val duration = if (version == 0) unsignedInt(offset + 4) else read(offset + 4, 8).long
+            // All-ones represents an unknown duration. A finalized recording needs a known duration.
+            val known = duration > 0 && !(version == 0 && duration == UINT32_MAX)
+            return timeScale > 0 && known
+        }
+
+        private fun dimensions(box: Box): Boolean {
+            val version = version(box)
+            val required = if (version == 0) 84 else 96
+            if (box.payloadSize < required) invalid("truncated tkhd box")
+            val offset = box.payload + if (version == 0) 76 else 88
+            // tkhd stores display width and height in unsigned 16.16 fixed point.
+            return unsignedInt(offset) >= 65536 && unsignedInt(offset + 4) >= 65536
+        }
+
+        private fun version(box: Box): Int {
+            if (box.payloadSize < 4) invalid("truncated ${box.type} full-box header")
+            val version = read(box.payload, 1).get().toInt() and 0xff
+            if (version !in 0..1) invalid("unsupported ${box.type} version $version")
+            return version
+        }
+
+        private fun unsignedInt(position: Long): Long = read(position, 4).int.toLong() and UINT32_MAX
+
+        private fun typeAt(position: Long): String = String(read(position, 4).array(), Charsets.ISO_8859_1)
+
+        private fun read(position: Long, count: Int): ByteBuffer {
+            if (position < 0 || count.toLong() > fileSize - position) invalid("truncated field at $position")
+            val buffer = ByteBuffer.allocate(count).order(ByteOrder.BIG_ENDIAN)
+            var offset = position
+            while (buffer.hasRemaining()) {
+                if (Thread.currentThread().isInterrupted) throw InterruptedException("MP4 validation interrupted")
+                val read = channel.read(buffer, offset)
+                if (read <= 0) invalid("truncated field at $offset")
+                offset += read
+            }
+            return buffer.flip()
+        }
+    }
+
+    private data class Box(val type: String, val payload: Long, val end: Long) {
+        val payloadSize: Long get() = end - payload
+    }
+
+    private class Track {
+        var hasMedia = false
+        var handler: String? = null
+        var positiveDuration: Boolean? = null
+        var positiveDimensions: Boolean? = null
+    }
+
+    private const val UINT32_MAX = 0xffff_ffffL
+    private const val MAX_DEPTH = 16
+    private const val MAX_BOXES = 100_000
+    private val CONTAINERS = setOf("minf", "stbl", "edts", "dinf", "udta", "mvex", "moof", "traf", "mfra", "tref", "sinf", "schi", "meco", "hnti", "hinf")
+
+    private fun invalid(message: String): Nothing = throw InvalidMp4RecordingException(message)
+}
