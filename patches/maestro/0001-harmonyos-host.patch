+            assertThat(acquired).isTrue()
+            assertThat(call(controller, "agent.result", mapOf("runId" to ids.first, "attemptId" to ids.second))["data"]["status"].asText())
+                .isEqualTo("cancelled")
+        } finally { allowExit.countDown(); controller.close() }
+    }
