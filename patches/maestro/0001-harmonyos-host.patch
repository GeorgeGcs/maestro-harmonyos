+                        assertThat(resource["archiveName"].isNull).isTrue()
+                        assertThat(resource["mediaRemoved"].asBoolean()).isFalse()
+                        assertThat(resource["clean"].asBoolean()).isFalse()
+                    }
+                }
+            }
