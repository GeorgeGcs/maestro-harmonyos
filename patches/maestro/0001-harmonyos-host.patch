+++ b/maestro-test/src/test/kotlin/maestro/harmonyos/HarmonyOSFlowIntegrationTest.kt
@@ -0,0 +1,167 @@
+package maestro.harmonyos
+
+import com.fasterxml.jackson.databind.ObjectMapper
+import com.google.common.truth.Truth.assertThat
+import kotlinx.coroutines.runBlocking
+import maestro.Maestro
+import maestro.MaestroException
+import maestro.drivers.HarmonyOSDriver
+import maestro.harmonyos.driver.HarmonyOSCommandException
+import maestro.harmonyos.driver.HarmonyOSDriverConfig
+import maestro.harmonyos.hdc.HdcClient
+import maestro.orchestra.MaestroCommand
+import maestro.orchestra.Orchestra
+import maestro.orchestra.util.Env.withEnv
+import maestro.orchestra.yaml.YamlCommandReader
+import maestro.utils.FileAccessScope
+import maestro.utils.TempFileHandler
+import org.junit.jupiter.api.Test
+import org.junit.jupiter.api.assertThrows
+import java.nio.file.Files
+import java.nio.file.Path
+import java.time.Duration
+import javax.imageio.ImageIO
+
+/** Real Maestro execution with a simulated HDC device, not a simulated Driver. */
+class HarmonyOSFlowIntegrationTest {
+    @Test
+    fun `standard YAML runs variables conditional subflow input assertions and screenshot`() {
+        withFlow("flow.yaml") { flow ->
+            val result = runBlocking { flow.orchestra.runFlow(flow.commands) }
+
+            assertThat(result.success).isTrue()
+            assertThat(flow.device.inputValues).containsExactly(INPUT_TEXT)
+            assertThat(flow.device.tapCount).isEqualTo(3)
+            assertThat(flow.device.launchedApps).containsExactly(APP_ID)
+            assertThat(flow.device.stoppedApps).containsExactly(APP_ID)
+            assertThat(flow.device.state).isEqualTo(SimulatedHarmonyOSDevice.State.RESULT)
+            assertThat(flow.device.remoteFiles).isEmpty()
+
+            val screenshots = Files.walk(flow.artifacts).use { paths ->
+                paths.filter { it.fileName.toString() == "flow-complete.png" }.toList()
+            }
+            assertThat(screenshots).hasSize(1)
+            val screenshot = ImageIO.read(screenshots.single().toFile())
+            assertThat(screenshot.width).isEqualTo(SimulatedHarmonyOSDevice.WIDTH)
+            assertThat(screenshot.height).isEqualTo(SimulatedHarmonyOSDevice.HEIGHT)
+            val manifest = ObjectMapper().readTree(flow.artifacts.resolve("manifest.json").toFile())
+            // The manifest registers takeScreenshot as a collection, with one entry per folder.
+            val screenshotEntries = manifest["entries"].filter { it["kind"].asText() == "TAKE_SCREENSHOT" }
+            assertThat(screenshotEntries).hasSize(1)
+            val screenshotEntry = screenshotEntries.single()
+            assertThat(screenshotEntry["count"].asInt()).isEqualTo(1)
+            assertThat(flow.artifacts.resolve(screenshotEntry["relativePath"].asText()).normalize())
+                .isEqualTo(screenshots.single().parent)
+            val workspaceFiles = Files.walk(flow.workspace).use { paths ->
+                paths.filter { Files.isRegularFile(it) }.map { it.fileName.toString() }.toList()
+            }
+            assertThat(workspaceFiles).containsExactlyElementsIn(RESOURCES)
+        }
+    }
+
+    @Test
+    fun `a failed YAML assertion stops later device actions`() {
+        withFlow("assertion-failure.yaml") { flow ->
+            assertThrows<MaestroException.AssertionFailure> {
+                runBlocking { flow.orchestra.runFlow(flow.commands) }
+            }
+            assertThat(flow.device.tapCount).isEqualTo(0)
+            assertThat(flow.device.inputValues).isEmpty()
+            assertThat(flow.device.remoteFiles).isEmpty()
+        }
+    }
+
+    @Test
+    fun `a nonzero device command status fails the flow even when host HDC exits zero`() {
+        withFlow("remote-failure.yaml", SimulatedHarmonyOSDevice(rejectTap = true)) { flow ->
+            val failure = assertThrows<HarmonyOSCommandException> {
+                runBlocking { flow.orchestra.runFlow(flow.commands) }
+            }
+            assertThat(failure.remoteExitCode).isEqualTo(37)
+            assertThat(flow.device.tapCount).isEqualTo(1)
+            assertThat(flow.device.state).isEqualTo(SimulatedHarmonyOSDevice.State.HOME)
+            assertThat(flow.device.inputValues).isEmpty()
+            assertThat(flow.device.remoteFiles).isEmpty()
+        }
+    }
+
+    @Test
+    fun `a failed UITest response stops the flow even when both exit codes are zero`() {
+        withFlow("remote-failure.yaml", SimulatedHarmonyOSDevice(tapFailureOutput = "Initialization failed.")) { flow ->
+            val failure = assertThrows<HarmonyOSCommandException> {
+                runBlocking { flow.orchestra.runFlow(flow.commands) }
+            }
+            assertThat(failure.stdout).contains("Initialization failed.")
+            assertThat(flow.device.tapCount).isEqualTo(1)
+            assertThat(flow.device.state).isEqualTo(SimulatedHarmonyOSDevice.State.HOME)
+            assertThat(flow.device.inputValues).isEmpty()
+            assertThat(flow.device.remoteFiles).isEmpty()
+        }
+    }
+
+    @Test
+    fun `an unsupported YAML operation fails instead of reporting success`() {
+        withFlow("unsupported.yaml") { flow ->
+            assertThrows<UnsupportedOperationException> {
+                runBlocking { flow.orchestra.runFlow(flow.commands) }
+            }
+            assertThat(flow.device.tapCount).isEqualTo(0)
+            assertThat(flow.device.inputValues).isEmpty()
+        }
+    }
+
+    private fun withFlow(
+        filename: String,
+        device: SimulatedHarmonyOSDevice = SimulatedHarmonyOSDevice(),
+        block: (FlowFixture) -> Unit,
+    ) {
+        TempFileHandler().use { temporary ->
+            val root = temporary.createTempDirectory("harmonyos-flow-").toPath()
+            val workspace = Files.createDirectory(root.resolve("workspace"))
+            val artifacts = Files.createDirectory(root.resolve("artifacts"))
+            RESOURCES.forEach { resource ->
+                checkNotNull(javaClass.getResourceAsStream("/harmonyos/$resource")).use { input ->
+                    Files.copy(input, workspace.resolve(resource))
+                }
+            }
+            val scope = FileAccessScope.under(workspace)
+            val commands = YamlCommandReader.readCommands(workspace.resolve(filename), scope)
+                .withEnv(mapOf("APP_ID" to APP_ID, "INPUT_TEXT" to INPUT_TEXT))
+            val driver = HarmonyOSDriver(
+                deviceId = SimulatedHarmonyOSDevice.DEVICE_ID,
+                hdc = HdcClient(executablePath = "simulated-hdc", runner = device),
+                config = HarmonyOSDriverConfig(
+                    abilityName = "EntryAbility",
+                    commandTimeout = Duration.ofSeconds(2),
+                    settleTimeout = Duration.ofMillis(250),
+                    pollInterval = Duration.ofMillis(1),
+                ),
+            )
+            driver.open()
+            Maestro(driver).use { maestro ->
+                val orchestra = Orchestra(
+                    maestro = maestro,
+                    artifactsDir = artifacts,
+                    lookupTimeoutMs = 0L,
+                    optionalLookupTimeoutMs = 0L,
+                    scope = scope,
+                )
+                block(FlowFixture(device, commands, orchestra, workspace, artifacts))
+            }
+        }
+    }
+
+    private data class FlowFixture(
+        val device: SimulatedHarmonyOSDevice,
+        val commands: List<MaestroCommand>,
+        val orchestra: Orchestra,
+        val workspace: Path,
+        val artifacts: Path,
+    )
+
+    private companion object {
+        const val APP_ID = "org.example.harmonyos.flowfixture"
+        const val INPUT_TEXT = "熊猫 O'Reilly \"测试\""
+        val RESOURCES = listOf("flow.yaml", "enter-name.yaml", "assertion-failure.yaml", "remote-failure.yaml", "unsupported.yaml")
+    }
+}
diff --git a/maestro-test/src/test/kotlin/maestro/harmonyos/SimulatedHarmonyOSDevice.kt b/maestro-test/src/test/kotlin/maestro/harmonyos/SimulatedHarmonyOSDevice.kt
new file mode 100644
index 0000000..d58af5f
--- /dev/null
+++ b/maestro-test/src/test/kotlin/maestro/harmonyos/SimulatedHarmonyOSDevice.kt
@@ -0,0 +1,217 @@
+package maestro.harmonyos
+
+import com.fasterxml.jackson.databind.ObjectMapper
+import maestro.harmonyos.hdc.HdcCommandResult
+import maestro.harmonyos.hdc.HdcCommandRunner
+import java.awt.Color
+import java.awt.image.BufferedImage
+import java.io.ByteArrayOutputStream
+import java.nio.file.Files
+import java.nio.file.Path
+import java.time.Duration
+import javax.imageio.ImageIO
+
+/** In-process HDC protocol fixture. It does not launch a shell or represent a real phone. */
+internal class SimulatedHarmonyOSDevice(
+    private val rejectTap: Boolean = false,
+    private val tapFailureOutput: String? = null,
+) : HdcCommandRunner {
+    enum class State { HOME, FORM, RESULT }
+
+    var state = State.HOME
+        private set
+    var tapCount = 0
+        private set
+    val inputValues = mutableListOf<String>()
+    val launchedApps = mutableListOf<String>()
+    val stoppedApps = mutableListOf<String>()
+    val remoteFiles = mutableMapOf<String, ByteArray>()
+
+    private var inputFocused = false
+    private var enteredName = ""
+    private val mapper = ObjectMapper()
+
+    @Synchronized
+    override fun run(command: List<String>, timeout: Duration): HdcCommandResult {
+        require(!timeout.isNegative && !timeout.isZero)
+        if (command.drop(1) == listOf("list", "targets")) return hostSuccess("$DEVICE_ID\n")
+        check(command.size >= 5 && command[1] == "-t" && command[2] == DEVICE_ID) {
+            "Unexpected HDC invocation: $command"
+        }
+        return when (command[3]) {
+            "file" -> {
+                check(command.size == 7 && command[4] == "recv") { "Unexpected file transfer: $command" }
+                val bytes = checkNotNull(remoteFiles[command[5]]) { "Remote file does not exist: ${command[5]}" }
+                Files.write(Path.of(command[6]), bytes)
+                hostSuccess("FileTransfer finish\n")
+            }
+            "shell" -> {
+                check(command.size == 5)
+                val arguments = decodeQuotedArguments(command[4])
+                if (arguments.take(2) == listOf("sh", "-c")) {
+                    check(arguments.size == 3)
+                    val script = arguments[2]
+                    val boundary = script.lastIndexOf("; __maestro_status=")
+                    check(boundary >= 0) { "Missing device exit-status wrapper" }
+                    val marker = checkNotNull(Regex("MAESTRO_EXIT_[a-f0-9]+=").find(script.substring(boundary))).value
+                    val result = execute(decodeQuotedArguments(script.substring(0, boundary)))
+                    // HDC can report host success even when the command on the device failed.
+                    hostSuccess("${result.stdout}\n$marker${result.exitCode}\n")
+                } else {
+                    execute(arguments)
+                }
+            }
+            else -> error("Unexpected HDC invocation: $command")
+        }
+    }
+
+    private fun execute(arguments: List<String>): HdcCommandResult = when {
+        arguments.take(2) == listOf("aa", "force-stop") -> {
+            check(arguments.size == 3)
+            stoppedApps += arguments[2]
+            state = State.HOME
+            inputFocused = false
+            enteredName = ""
+            hostSuccess("force stop process successfully.\n")
+        }
+        arguments.take(2) == listOf("aa", "start") -> {
+            check(arguments.size == 6 && arguments[2] == "-b" && arguments[4] == "-a")
+            check(arguments[5] == "EntryAbility")
+            launchedApps += arguments[3]
+            state = State.HOME
+            hostSuccess("start ability successfully.\n")
+        }
+        arguments.take(3) == listOf("uitest", "dumpLayout", "-p") -> {
+            check(arguments.size == 4)
+            remoteFiles[arguments[3]] = mapper.writeValueAsBytes(layout())
+            hostSuccess("Dump layout saved\n")
+        }
+        arguments.take(3) == listOf("uitest", "screenCap", "-p") -> {
+            check(arguments.size == 4)
+            remoteFiles[arguments[3]] = screenshot()
+            hostSuccess("Screen capture saved\n")
+        }
+        arguments.take(3) == listOf("uitest", "uiInput", "click") -> {
+            check(arguments.size == 5)
+            tap(arguments[3].toInt(), arguments[4].toInt())
+        }
+        arguments.take(3) == listOf("uitest", "uiInput", "text") -> {
+            check(arguments.size == 4 && state == State.FORM && inputFocused) {
+                "Text input requires the form's input field to be focused"
+            }
+            inputValues += arguments[3]
+            enteredName += arguments[3]
+            hostSuccess("No Error")
+        }
+        arguments.take(2) == listOf("rm", "-f") -> {
+            check(arguments.size == 3)
+            remoteFiles.remove(arguments[2])
+            hostSuccess()
+        }
+        else -> error("Unexpected device command: $arguments")
+    }
+
+    private fun tap(x: Int, y: Int): HdcCommandResult {
+        tapCount++
+        if (rejectTap) return HdcCommandResult(37, "tap rejected by simulated device", "")
+        tapFailureOutput?.let { return hostSuccess(it) }
+        when {
+            state == State.HOME && x in 40..359 && y in 120..199 -> state = State.FORM
+            state == State.FORM && x in 40..359 && y in 120..199 -> inputFocused = true
+            state == State.FORM && x in 40..359 && y in 300..379 -> {
+                check(enteredName.isNotEmpty())
+                state = State.RESULT
+            }
+            else -> error("Unexpected tap at ($x, $y) on $state")
+        }
+        return hostSuccess("No Error")
+    }
+
+    private fun layout(): Map<String, Any> {
+        val children = when (state) {
+            State.HOME -> listOf(
+                node(text = "欢迎", bounds = "[40,40][360,100]"),
+                node(id = "open-form", text = "填写表单", bounds = "[40,120][360,200]", clickable = true),
+            )
+            State.FORM -> listOf(
+                node(text = "姓名", bounds = "[40,40][360,100]"),
+                node(id = "name-input", text = enteredName, bounds = "[40,120][360,200]", clickable = true, focused = inputFocused),
+                node(id = "submit", text = "提交", bounds = "[40,300][360,380]", clickable = true),
+            )
+            State.RESULT -> listOf(
+                node(text = "已提交", bounds = "[40,40][360,100]"),
+                node(text = enteredName, bounds = "[40,120][360,200]"),
+            )
+        }
+        return node(bounds = "[0,0][$WIDTH,$HEIGHT]", children = children)
+    }
+
+    private fun node(
+        id: String = "",
+        text: String = "",
+        bounds: String,
+        clickable: Boolean = false,
+        focused: Boolean = false,
+        children: List<Map<String, Any>> = emptyList(),
+    ): Map<String, Any> = mapOf(
+        "attributes" to mapOf(
+            "id" to id,
+            "text" to text,
+            "type" to if (clickable) "Button" else "Text",
+            "bounds" to bounds,
+            "clickable" to clickable.toString(),
+            "focused" to focused.toString(),
+            "enabled" to "true",
+            "visible" to "true",
+        ),
+        "children" to children,
+    )
+
+    private fun screenshot(): ByteArray {
+        val image = BufferedImage(WIDTH, HEIGHT, BufferedImage.TYPE_INT_RGB)
+        val graphics = image.createGraphics()
+        try {
+            graphics.color = when (state) {
+                State.HOME -> Color.WHITE
+                State.FORM -> if (inputFocused) Color.LIGHT_GRAY else Color.GRAY
+                State.RESULT -> Color.GREEN
+            }
+            graphics.fillRect(0, 0, WIDTH, HEIGHT)
+        } finally {
+            graphics.dispose()
+        }
+        return ByteArrayOutputStream().use { output ->
+            check(ImageIO.write(image, "png", output))
+            output.toByteArray()
+        }
+    }
+
+    /** Decodes only the quoted argument form emitted by HdcClient; never evaluates shell syntax. */
+    private fun decodeQuotedArguments(command: String): List<String> {
+        val arguments = mutableListOf<String>()
+        var position = 0
+        while (position < command.length) {
+            while (position < command.length && command[position].isWhitespace()) position++
+            if (position == command.length) break
+            val argument = StringBuilder()
+            while (position < command.length && !command[position].isWhitespace()) {
+                val quote = command[position++]
+                check(quote == '\'' || quote == '"') { "Expected a quoted argument: $command" }
+                val end = command.indexOf(quote, position)
+                check(end >= 0) { "Unterminated argument: $command" }
+                argument.append(command, position, end)
+                position = end + 1
+            }
+            arguments += argument.toString()
+        }
+        return arguments
+    }
+
+    private fun hostSuccess(stdout: String = "") = HdcCommandResult(0, stdout, "")
+
+    companion object {
+        const val DEVICE_ID = "simulated-harmonyos-device"
+        const val WIDTH = 400
+        const val HEIGHT = 800
+    }
+}
