+++ b/maestro-client/src/main/java/maestro/harmonyos/hdc/HdcClient.kt
@@ -0,0 +1,115 @@
+package maestro.harmonyos.hdc
+
+import java.nio.file.Path
+import java.time.Duration
+
+class HdcCommandException(val result: HdcCommandResult) :
+    HdcException("HDC command failed (exit ${result.exitCode}): ${diagnostic(result)}") {
+    companion object {
+        private fun diagnostic(result: HdcCommandResult): String =
+            result.stderr.ifBlank { result.stdout }.trim().take(2048)
+    }
+}
+
+class HdcDeviceSelectionException(message: String) : HdcException(message)
+
+/** Host transport only; shell command availability must be checked on the target device. */
+class HdcClient(
+    private val executablePath: String = defaultExecutable(),
+    private val runner: HdcCommandRunner = ProcessHdcCommandRunner(),
+    private val commandTimeout: Duration = Duration.ofSeconds(10),
+) {
+    init {
+        require(executablePath.isNotBlank() && '\u0000' !in executablePath) { "A valid HDC executable is required" }
+        require(!commandTimeout.isZero && !commandTimeout.isNegative) { "Timeout must be positive" }
+    }
+
+    fun listDevices(): List<String> {
+        val result = execute(listOf("list", "targets"), commandTimeout)
+        if (result.stderr.isNotBlank()) {
+            throw HdcException("HDC device listing returned diagnostics: ${result.stderr.trim().take(2048)}")
+        }
+        return parseDeviceList(result.stdout)
+    }
+
+    fun selectDevice(requestedId: String? = null): String {
+        if (requestedId != null) validateDeviceId(requestedId)
+        val devices = listDevices()
+        if (requestedId != null) {
+            if (requestedId !in devices) throw HdcDeviceSelectionException("The requested HDC device is not available")
+            return requestedId
+        }
+        return when (devices.size) {
+            0 -> throw HdcDeviceSelectionException("No HDC device found. Connect and authorize a device first.")
+            1 -> devices.single()
+            else -> throw HdcDeviceSelectionException("Multiple HDC devices found. Select a device explicitly.")
+        }
+    }
+
+    /**
+     * Arguments are quoted for the device shell as well as kept separate from host options.
+     * The exit code belongs to the host HDC process; callers must also check device-command results.
+     */
+    fun shell(
+        deviceId: String,
+        arguments: List<String>,
+        timeout: Duration = commandTimeout,
+    ): HdcCommandResult {
+        validateDeviceId(deviceId)
+        require(arguments.isNotEmpty() && arguments.first().isNotBlank()) { "A shell command is required" }
+        val command = arguments.joinToString(" ", transform = ::quoteShellArgument)
+        return execute(listOf("-t", deviceId, "shell", command), timeout)
+    }
+
+    fun receiveFile(
+        deviceId: String,
+        remotePath: String,
+        localPath: Path,
+        timeout: Duration = commandTimeout,
+    ): HdcCommandResult {
+        validateDeviceId(deviceId)
+        require(remotePath.startsWith('/') && '\u0000' !in remotePath && '\n' !in remotePath && '\r' !in remotePath) {
+            "An absolute device file path is required"
+        }
+        return execute(listOf("-t", deviceId, "file", "recv", remotePath, localPath.toAbsolutePath().toString()), timeout)
+    }
+
+    private fun execute(arguments: List<String>, timeout: Duration): HdcCommandResult {
+        val result = runner.run(listOf(executablePath) + arguments, timeout)
+        if (result.exitCode != 0 || hasHdcFailure(result.stdout) || hasHdcFailure(result.stderr)) {
+            throw HdcCommandException(result)
+        }
+        return result
+    }
+
+    companion object {
+        private val deviceIdPattern = Regex("[A-Za-z0-9][A-Za-z0-9._:-]*")
+        private val diagnosticTokens = setOf("error", "fail", "failed", "failure", "warning", "warn", "usage", "help", "hdc")
+        private val hdcFailurePattern = Regex("(?im)^\\s*(?:\\[\\s*(?:fail|error)\\s*]|error:|failed:)")
+
+        private fun defaultExecutable(): String = System.getenv("MAESTRO_HARMONYOS_HDC")
+            ?.takeIf { it.isNotBlank() } ?: "hdc"
+
+        private fun hasHdcFailure(output: String): Boolean = hdcFailurePattern.containsMatchIn(output)
+
+        internal fun parseDeviceList(output: String): List<String> {
+            val lines = output.lineSequence().map { it.trim() }.filter { it.isNotEmpty() }.toList()
+            if (lines.isEmpty() || lines == listOf("[Empty]")) return emptyList()
+            if (lines.any { !deviceIdPattern.matches(it) || it.lowercase() in diagnosticTokens }) {
+                throw HdcException("Unexpected HDC device-list output; no device was selected")
+            }
+            return lines.distinct()
+        }
+
+        private fun validateDeviceId(deviceId: String) {
+            require(deviceIdPattern.matches(deviceId) && deviceId.lowercase() !in diagnosticTokens) {
+                "Invalid HDC device identifier"
+            }
+        }
+
+        internal fun quoteShellArgument(value: String): String {
+            require('\u0000' !in value) { "Shell arguments cannot contain NUL" }
+            return "'" + value.replace("'", "'\"'\"'") + "'"
+        }
+    }
+}
diff --git a/maestro-client/src/main/java/maestro/harmonyos/hdc/HdcCommandRunner.kt b/maestro-client/src/main/java/maestro/harmonyos/hdc/HdcCommandRunner.kt
new file mode 100644
index 0000000..5b3e7ec
--- /dev/null
+++ b/maestro-client/src/main/java/maestro/harmonyos/hdc/HdcCommandRunner.kt
@@ -0,0 +1,171 @@
+package maestro.harmonyos.hdc
+
+import java.io.ByteArrayOutputStream
+import java.io.IOException
+import java.io.InputStream
+import java.time.Duration
+import java.util.concurrent.ExecutionException
+import java.util.concurrent.Executors
+import java.util.concurrent.Future
+import java.util.concurrent.TimeUnit
+import java.util.concurrent.TimeoutException
+
+data class HdcCommandResult(val exitCode: Int, val stdout: String, val stderr: String)
+
+fun interface HdcCommandRunner {
+    fun run(command: List<String>, timeout: Duration): HdcCommandResult
+}
+
+open class HdcException(message: String, cause: Throwable? = null) : RuntimeException(message, cause)
+
+class HdcTimeoutException(val timeout: Duration) : HdcException("HDC command exceeded ${timeout.toMillis()} ms")
+
+class HdcOutputLimitException(stream: String, limit: Int) :
+    HdcException("HDC $stream exceeded the $limit byte output limit")
+
+/** Runs one finite command. Each output stream has its own memory limit. */
+class ProcessHdcCommandRunner(private val maxOutputBytes: Int = 4 * 1024 * 1024) : HdcCommandRunner {
+
+    init {
+        require(maxOutputBytes > 0) { "Output limit must be positive" }
+    }
+
+    override fun run(command: List<String>, timeout: Duration): HdcCommandResult {
+        require(command.isNotEmpty() && command.first().isNotBlank()) { "An executable is required" }
+        require(command.none { '\u0000' in it }) { "Command arguments cannot contain NUL" }
+        require(!timeout.isZero && !timeout.isNegative) { "Timeout must be positive" }
+        val timeoutNanos = timeout.toNanos()
+        val deadline = System.nanoTime() + timeoutNanos
+        val process = try {
+            ProcessBuilder(processArguments(command)).start()
+        } catch (e: IOException) {
+            throw HdcException("Unable to start HDC executable: ${command.first()}", e)
+        }
+        val descendants = linkedMapOf<Long, ProcessHandle>()
+        val readers = Executors.newFixedThreadPool(2) { task ->
+            Thread(task, "maestro-hdc-output").apply { isDaemon = true }
+        }
+        try {
+            // Finite commands must not wait for keyboard input.
+            process.outputStream.close()
+            val stdout = readers.submit<String> { readOutput(process.inputStream, "stdout") }
+            val stderr = readers.submit<String> { readOutput(process.errorStream, "stderr") }
+            while (true) {
+                rememberDescendants(process, descendants)
+                checkReader(stdout)
+                checkReader(stderr)
+                val remaining = remainingNanos(deadline, timeout)
+                if (process.waitFor(minOf(remaining, TimeUnit.MILLISECONDS.toNanos(25)), TimeUnit.NANOSECONDS)) {
+                    break
+                }
+            }
+            return HdcCommandResult(
+                process.exitValue(),
+                awaitOutput(stdout, deadline, timeout),
+                awaitOutput(stderr, deadline, timeout),
+            )
+        } catch (e: InterruptedException) {
+            terminate(process, descendants)
+            Thread.currentThread().interrupt()
+            throw e
+        } catch (e: Exception) {
+            terminate(process, descendants)
+            throw e
+        } finally {
+            readers.shutdownNow()
+            runCatching { process.inputStream.close() }
+            runCatching { process.errorStream.close() }
+            runCatching { process.outputStream.close() }
+        }
+    }
+
+    private fun readOutput(stream: InputStream, name: String): String {
+        val output = ByteArrayOutputStream(minOf(maxOutputBytes, 8192))
+        val buffer = ByteArray(8192)
+        while (true) {
+            val count = stream.read(buffer)
+            if (count < 0) break
+            if (count > maxOutputBytes - output.size()) throw HdcOutputLimitException(name, maxOutputBytes)
+            output.write(buffer, 0, count)
+        }
+        return output.toString(Charsets.UTF_8)
+    }
+
+    @Suppress("DEPRECATION")
+    private fun processArguments(command: List<String>): List<String> {
+        if (!System.getProperty("os.name").startsWith("Windows")) return command
+        val executable = command.first()
+        require('"' !in executable) { "Pass the Windows executable path without surrounding quotes" }
+        require(!executable.endsWith(".cmd", true) && !executable.endsWith(".bat", true)) {
+            "HDC must be a native executable, not a Windows command script"
+        }
+        val securityManager = System.getSecurityManager()
+        val ambiguousCommands = System.getProperty(
+            "jdk.lang.Process.allowAmbiguousCommands", if (securityManager == null) "true" else "false",
+        )
+        if (ambiguousCommands.equals("false", ignoreCase = true)) {
+            // The JDK escapes embedded quotes in strict mode, but interprets a leading/trailing
+            // quote pair as caller-supplied quoting and would silently strip literal quotes.
+            require(command.drop(1).none { it.length >= 2 && it.startsWith('"') && it.endsWith('"') }) {
+                "This JDK Windows strict quoting mode cannot preserve an argument enclosed in literal double quotes"
+            }
+            return command
+        }
+        require(securityManager == null) { "Legacy Windows argument quoting with a SecurityManager is not supported" }
+
+        // JDK 17's default Windows mode does not escape embedded quotes. Encode complete CRT
+        // arguments here; ProcessImpl preserves these outer-quoted strings without re-encoding.
+        return listOf(executable) + command.drop(1).map(::quoteWindowsArgument)
+    }
+
+    private fun quoteWindowsArgument(value: String): String = buildString {
+        append('"')
+        var backslashes = 0
+        value.forEach { character ->
+            if (character == '\\') {
+                backslashes++
+            } else {
+                repeat(if (character == '"') backslashes * 2 + 1 else backslashes) { append('\\') }
+                append(character)
+                backslashes = 0
+            }
+        }
+        // Backslashes immediately before the closing quote must be doubled.
+        repeat(backslashes * 2) { append('\\') }
+        append('"')
+    }
+
+    private fun checkReader(reader: Future<String>) {
+        if (reader.isDone) unwrap { reader.get() }
+    }
+
+    private fun awaitOutput(reader: Future<String>, deadline: Long, timeout: Duration): String = try {
+        unwrap { reader.get(remainingNanos(deadline, timeout), TimeUnit.NANOSECONDS) }
+    } catch (_: TimeoutException) {
+        throw HdcTimeoutException(timeout)
+    }
+
+    private fun <T> unwrap(action: () -> T): T = try {
+        action()
+    } catch (e: ExecutionException) {
+        val cause = e.cause
+        if (cause is HdcException) throw cause
+        throw HdcException("Unable to read HDC command output", cause ?: e)
+    }
+
+    private fun remainingNanos(deadline: Long, timeout: Duration): Long {
+        val remaining = deadline - System.nanoTime()
+        if (remaining <= 0) throw HdcTimeoutException(timeout)
+        return remaining
+    }
+
+    private fun rememberDescendants(process: Process, descendants: MutableMap<Long, ProcessHandle>) {
+        process.descendants().use { children -> children.forEach { descendants[it.pid()] = it } }
+    }
+
+    private fun terminate(process: Process, descendants: MutableMap<Long, ProcessHandle>) {
+        runCatching { rememberDescendants(process, descendants) }
+        descendants.values.toList().asReversed().forEach { child -> runCatching { child.destroyForcibly() } }
+        runCatching { process.destroyForcibly() }
+    }
+}
