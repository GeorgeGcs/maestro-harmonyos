@@ -0,0 +1,133 @@
+package maestro.harmonyos.hdc
+
+import com.google.common.truth.Truth.assertThat
+import org.junit.jupiter.api.Assertions.assertThrows
+import org.junit.jupiter.api.Test
+import java.nio.file.Path
+import java.time.Duration
+
+class HdcClientTest {
+    @Test
+    fun `empty device output is an empty list`() {
+        listOf("", "  \r\n", "[Empty]\r\n").forEach { output ->
+            assertThat(client(output).listDevices()).isEmpty()
+        }
+    }
+
+    @Test
+    fun `device discovery uses plain listing and removes duplicates`() {
+        val runner = RecordingRunner(HdcCommandResult(0, "USB-001\r\n192.0.2.1:8710\r\nUSB-001\r\n", ""))
+        val client = HdcClient("C:/SDK with spaces/hdc.exe", runner)
+
+        assertThat(client.listDevices()).containsExactly("USB-001", "192.0.2.1:8710").inOrder()
+        assertThat(runner.command).containsExactly("C:/SDK with spaces/hdc.exe", "list", "targets").inOrder()
+    }
+
+    @Test
+    fun `diagnostics are not treated as device identifiers`() {
+        listOf(
+            "[Fail] failed to connect",
+            "error: device not found",
+            "daemon started successfully",
+            "error",
+            "USB-001 USB Connected",
+            "USB-001\n[Empty]",
+            "USB-001\n[Warning] daemon restarted",
+        ).forEach { output ->
+            assertThrows(HdcException::class.java) { client(output).listDevices() }
+        }
+    }
+
+    @Test
+    fun `listing diagnostics on stderr fail even with zero exit code`() {
+        val runner = RecordingRunner(HdcCommandResult(0, "USB-001", "connection warning"))
+        assertThrows(HdcException::class.java) { HdcClient("hdc", runner).listDevices() }
+    }
+
+    @Test
+    fun `single device is selected automatically`() {
+        assertThat(client("USB-001").selectDevice()).isEqualTo("USB-001")
+    }
+
+    @Test
+    fun `missing and ambiguous devices require user selection`() {
+        assertThrows(HdcDeviceSelectionException::class.java) { client("[Empty]").selectDevice() }
+        assertThrows(HdcDeviceSelectionException::class.java) { client("USB-001\nUSB-002").selectDevice() }
+        assertThrows(HdcDeviceSelectionException::class.java) { client("USB-001").selectDevice("USB-002") }
+        assertThat(client("USB-001\nUSB-002").selectDevice("USB-002")).isEqualTo("USB-002")
+    }
+
+    @Test
+    fun `nonzero exit preserves error output`() {
+        val result = HdcCommandResult(17, "output", "connection lost")
+        val error = assertThrows(HdcCommandException::class.java) {
+            HdcClient("hdc", RecordingRunner(result)).listDevices()
+        }
+        assertThat(error.result).isEqualTo(result)
+        assertThat(error.message).contains("exit 17")
+        assertThat(error.message).contains("connection lost")
+    }
+
+    @Test
+    fun `failure text with a successful host exit is still an error`() {
+        val error = assertThrows(HdcCommandException::class.java) {
+            HdcClient("hdc", RecordingRunner(HdcCommandResult(0, "[Fail] device offline", "")))
+                .shell("USB-001", listOf("uitest", "dumpLayout"))
+        }
+        assertThat(error.result.exitCode).isEqualTo(0)
+    }
+
+    @Test
+    fun `shell arguments are quoted for device shell and target is explicit`() {
+        val runner = RecordingRunner(HdcCommandResult(0, "done", ""))
+        val timeout = Duration.ofSeconds(3)
+        HdcClient("hdc", runner).shell(
+            "USB-001", listOf("printf", "%s", "中文 text\n'quoted'; echo \$HOME", ""), timeout,
+        )
+
+        assertThat(runner.command).containsExactly(
+            "hdc", "-t", "USB-001", "shell",
+            "'printf' '%s' '中文 text\n'\"'\"'quoted'\"'\"'; echo \$HOME' ''",
+        ).inOrder()
+        assertThat(runner.timeout).isEqualTo(timeout)
+    }
+
+    @Test
+    fun `invalid targets and NUL arguments fail before starting a command`() {
+        val runner = RecordingRunner(HdcCommandResult(0, "", ""))
+        val client = HdcClient("hdc", runner)
+        listOf("", "-t", "USB 001", "USB;reboot", "USB\n001").forEach { target ->
+            assertThrows(IllegalArgumentException::class.java) { client.shell(target, listOf("echo")) }
+        }
+        assertThrows(IllegalArgumentException::class.java) { client.shell("USB-001", listOf("echo", "\u0000")) }
+        assertThrows(IllegalArgumentException::class.java) { client.shell("USB-001", emptyList()) }
+        assertThat(runner.command).isEmpty()
+    }
+
+    @Test
+    fun `receive file uses explicit target and separate path arguments`() {
+        val runner = RecordingRunner(HdcCommandResult(0, "FileTransfer finish", ""))
+        val target = Path.of("artifacts", "screen capture.png")
+        HdcClient("hdc", runner).receiveFile("USB-001", "/data/local/tmp/capture.png", target)
+
+        assertThat(runner.command).containsExactly(
+            "hdc", "-t", "USB-001", "file", "recv", "/data/local/tmp/capture.png", target.toAbsolutePath().toString(),
+        ).inOrder()
+        assertThrows(IllegalArgumentException::class.java) {
+            HdcClient("hdc", runner).receiveFile("USB-001", "-a", target)
+        }
+    }
+
+    private fun client(output: String): HdcClient = HdcClient("hdc", RecordingRunner(HdcCommandResult(0, output, "")))
+
+    private class RecordingRunner(private val result: HdcCommandResult) : HdcCommandRunner {
+        var command: List<String> = emptyList()
+        var timeout: Duration? = null
+
+        override fun run(command: List<String>, timeout: Duration): HdcCommandResult {
+            this.command = command
+            this.timeout = timeout
+            return result
+        }
+    }
+}
diff --git a/maestro-client/src/test/kotlin/maestro/harmonyos/hdc/ProcessHdcCommandRunnerTest.kt b/maestro-client/src/test/kotlin/maestro/harmonyos/hdc/ProcessHdcCommandRunnerTest.kt
new file mode 100644
index 0000000..e8bdd2d
--- /dev/null
+++ b/maestro-client/src/test/kotlin/maestro/harmonyos/hdc/ProcessHdcCommandRunnerTest.kt
@@ -0,0 +1,189 @@
+package maestro.harmonyos.hdc
+
+import com.google.common.truth.Truth.assertThat
+import maestro.utils.TempFileHandler
+import org.junit.jupiter.api.Assertions.assertThrows
+import org.junit.jupiter.api.Test
+import java.io.File
+import java.nio.file.Path
+import java.time.Duration
+import java.util.Base64
+import java.util.concurrent.atomic.AtomicBoolean
+import java.util.concurrent.atomic.AtomicReference
+import kotlin.system.exitProcess
+
+class ProcessHdcCommandRunnerTest {
+    @Test
+    fun `captures stdout stderr and nonzero exit independently`() {
+        val result = ProcessHdcCommandRunner().run(HdcProcessTestChild.command("failure"), Duration.ofSeconds(10))
+
+        assertThat(result.exitCode).isEqualTo(7)
+        assertThat(result.stdout.trim()).isEqualTo("command output")
+        assertThat(result.stderr.trim()).isEqualTo("command error")
+    }
+
+    @Test
+    fun `host arguments remain literal without a command shell`() {
+        val arguments = listOf(
+            "space separated", "中文", "a'\"b", "\$HOME; echo injected", "", "line\nbreak",
+            "\"", "\"\"", "\"quoted\"", "plain\\", "path with space\\", "\\", "\\\\",
+            " leading ", "\ttab\t", "line\r\nbreak",
+        ) + (0..5).flatMap { count ->
+            val slashes = "\\".repeat(count)
+            listOf("before${slashes}\"after", "before${slashes}\"", "tail with space$slashes")
+        }
+        val result = ProcessHdcCommandRunner().run(
+            HdcProcessTestChild.command("arguments", *arguments.toTypedArray()), Duration.ofSeconds(10),
+        )
+        val decoded = result.stdout.lineSequence().filter { it.startsWith("arg:") }
+            .map { String(Base64.getDecoder().decode(it.removePrefix("arg:")), Charsets.UTF_8) }.toList()
+
+        assertThat(result.exitCode).isEqualTo(0)
+        assertThat(decoded).containsExactlyElementsIn(arguments).inOrder()
+    }
+
+    @Test
+    fun `drains both streams while process is running`() {
+        val result = ProcessHdcCommandRunner().run(HdcProcessTestChild.command("flood"), Duration.ofSeconds(10))
+
+        assertThat(result.exitCode).isEqualTo(0)
+        assertThat(result.stdout.length).isEqualTo(262144)
+        assertThat(result.stderr.length).isEqualTo(262144)
+    }
+
+    @Test
+    fun `output limit fails explicitly instead of truncating a result`() {
+        assertThrows(HdcOutputLimitException::class.java) {
+            ProcessHdcCommandRunner(maxOutputBytes = 1024).run(
+                HdcProcessTestChild.command("flood"), Duration.ofSeconds(10),
+            )
+        }
+    }
+
+    @Test
+    fun `timeout terminates the command and its child`() {
+        TempFileHandler().use { temporary ->
+            val parentPid = temporary.createTempFile("hdc-parent", ".pid")
+            val childPid = temporary.createTempFile("hdc-child", ".pid")
+            try {
+                assertThrows(HdcTimeoutException::class.java) {
+                    ProcessHdcCommandRunner().run(
+                        HdcProcessTestChild.command("spawn", parentPid.path, childPid.path), Duration.ofSeconds(3),
+                    )
+                }
+                assertStopped(parentPid)
+                assertStopped(childPid)
+            } finally {
+                stopFromPidFile(parentPid)
+                stopFromPidFile(childPid)
+            }
+        }
+    }
+
+    @Test
+    fun `interruption terminates the command and preserves interrupted status`() {
+        TempFileHandler().use { temporary ->
+            val pidFile = temporary.createTempFile("hdc-interrupted", ".pid")
+            val thrown = AtomicReference<Throwable>()
+            val interrupted = AtomicBoolean()
+            val thread = Thread {
+                try {
+                    ProcessHdcCommandRunner().run(
+                        HdcProcessTestChild.command("sleep", pidFile.path), Duration.ofSeconds(30),
+                    )
+                } catch (e: Throwable) {
+                    thrown.set(e)
+                    interrupted.set(Thread.currentThread().isInterrupted)
+                }
+            }
+            thread.start()
+            try {
+                waitUntil { pidFile.readText().trim().toLongOrNull() != null }
+                thread.interrupt()
+                thread.join(5000)
+
+                assertThat(thread.isAlive).isFalse()
+                assertThat(thrown.get()).isInstanceOf(InterruptedException::class.java)
+                assertThat(interrupted.get()).isTrue()
+                assertStopped(pidFile)
+            } finally {
+                thread.interrupt()
+                stopFromPidFile(pidFile)
+                thread.join(5000)
+            }
+        }
+    }
+
+    @Test
+    fun `missing executable and invalid inputs fail clearly`() {
+        assertThrows(HdcException::class.java) {
+            ProcessHdcCommandRunner().run(listOf("maestro-nonexistent-hdc-test-executable"), Duration.ofSeconds(1))
+        }
+        assertThrows(IllegalArgumentException::class.java) {
+            ProcessHdcCommandRunner().run(HdcProcessTestChild.command("failure"), Duration.ZERO)
+        }
+        assertThrows(IllegalArgumentException::class.java) {
+            ProcessHdcCommandRunner().run(listOf("hdc", "\u0000"), Duration.ofSeconds(1))
+        }
+    }
+
+    private fun assertStopped(pidFile: File) {
+        val pid = pidFile.readText().trim().toLong()
+        waitUntil { !ProcessHandle.of(pid).map { it.isAlive }.orElse(false) }
+    }
+
+    private fun stopFromPidFile(pidFile: File) {
+        pidFile.readText().trim().toLongOrNull()?.let { pid ->
+            ProcessHandle.of(pid).ifPresent { it.destroyForcibly() }
+        }
+    }
+
+    private fun waitUntil(condition: () -> Boolean) {
+        val deadline = System.nanoTime() + Duration.ofSeconds(5).toNanos()
+        while (!condition() && System.nanoTime() < deadline) Thread.sleep(20)
+        assertThat(condition()).isTrue()
+    }
+}
+
+/** Local JVM fixture; never invokes HDC or accesses a device. */
+object HdcProcessTestChild {
+    fun command(vararg arguments: String): List<String> {
+        val windows = System.getProperty("os.name").startsWith("Windows")
+        val java = Path.of(System.getProperty("java.home"), "bin", if (windows) "java.exe" else "java").toString()
+        val classpath = listOf(HdcProcessTestChild::class.java, Unit::class.java)
+            .map { Path.of(it.protectionDomain.codeSource.location.toURI()).toString() }
+            .distinct().joinToString(File.pathSeparator)
+        return listOf(java, "-Dfile.encoding=UTF-8", "-cp", classpath, HdcProcessTestChild::class.java.name) + arguments
+    }
+
+    @JvmStatic
+    fun main(arguments: Array<String>) {
+        when (arguments[0]) {
+            "failure" -> {
+                println("command output")
+                System.err.println("command error")
+                exitProcess(7)
+            }
+            "arguments" -> arguments.drop(1).forEach {
+                println("arg:" + Base64.getEncoder().encodeToString(it.toByteArray(Charsets.UTF_8)))
+            }
+            "flood" -> {
+                val bytes = ByteArray(4096) { 'x'.code.toByte() }
+                repeat(64) {
+                    System.out.write(bytes)
+                    System.err.write(bytes)
+                }
+            }
+            "sleep" -> {
+                File(arguments[1]).writeText(ProcessHandle.current().pid().toString())
+                Thread.sleep(30000)
+            }
+            "spawn" -> {
+                File(arguments[1]).writeText(ProcessHandle.current().pid().toString())
+                ProcessBuilder(command("sleep", arguments[2])).inheritIO().start()
+                Thread.sleep(30000)
+            }
+            else -> error("Unknown fixture mode")
+        }
+    }
+}
diff --git a/maestro-client/src/test/kotlin/maestro/harmonyos/layout/HierarchyReaderTest.kt b/maestro-client/src/test/kotlin/maestro/harmonyos/layout/HierarchyReaderTest.kt
