+++ b/maestro-client/src/main/java/maestro/harmonyos/hdc/HarmonyOSUptimeObservation.kt
@@ -0,0 +1,54 @@
+package maestro.harmonyos.hdc
+
+import java.math.BigInteger
+
+/**
+ * Supported format/semantics: no-argument English Toybox uptime, based on
+ * https://raw.githubusercontent.com/openharmony/third_party_toybox/master/toys/other/uptime.c
+ * That implementation reads sysinfo and divides uptime seconds by 60 before formatting.
+ * This contract does not identify the device vendor's exact implementation or a boot UUID.
+ */
+class HarmonyOSUptimeObservation private constructor(val raw: String, val minutes: String) {
+    /** Interval for the provider's reported uptime, not a millisecond-precision clock sample. */
+    val lowerBoundMilliseconds: String get() = (BigInteger(minutes) * MILLIS_PER_MINUTE).toString()
+    val upperBoundMillisecondsExclusive: String get() = ((BigInteger(minutes) + BigInteger.ONE) * MILLIS_PER_MINUTE).toString()
+
+    companion object {
+        const val PROVIDER = "toybox-uptime-english-floor-minute-v1"
+        private const val MAX_OUTPUT_LENGTH = 512
+        private val MILLIS_PER_MINUTE = BigInteger.valueOf(60_000)
+        private val MINUTES_PER_DAY = BigInteger.valueOf(1_440)
+        private val MINUTES_PER_HOUR = BigInteger.valueOf(60)
+        private const val DECIMAL_LOAD = "(?:0|[1-9][0-9]*)\\.[0-9]{2}"
+        // Spaces mirror the published printf format, including %2d for nonzero hours.
+        // Exactly one LF or CRLF is accepted; no trimming can hide diagnostics or another line.
+        private val output = Regex(
+            " ([0-9]{2}):([0-5][0-9]):([0-5][0-9]) up " +
+                "(?:([1-9][0-9]*) (day|days), )?" +
+                "(?:( [1-9]|1[0-9]|2[0-3]):([0-5][0-9])|([0-9]|[1-5][0-9]) min),  " +
+                "(0|[1-9][0-9]*) (user|users),  load average: " +
+                "$DECIMAL_LOAD, $DECIMAL_LOAD, $DECIMAL_LOAD\\r?\\n"
+        )
+
+        fun parse(raw: String): HarmonyOSUptimeObservation {
+            require(raw.length <= MAX_OUTPUT_LENGTH) { "Uptime output exceeds 512 characters." }
+            val match = output.matchEntire(raw) ?: throw IllegalArgumentException("Unsupported uptime output.")
+            require(match.groupValues[1].toInt() <= 23) { "Invalid current-time hour in uptime output." }
+            val days = match.groupValues[4].takeIf { it.isNotEmpty() }?.let(::BigInteger) ?: BigInteger.ZERO
+            if (match.groupValues[4].isNotEmpty()) {
+                require(match.groupValues[5] == if (days == BigInteger.ONE) "day" else "days") { "Invalid day plurality." }
+            }
+            val users = BigInteger(match.groupValues[9])
+            require(match.groupValues[10] == if (users == BigInteger.ONE) "user" else "users") { "Invalid user plurality." }
+            val withinDay = if (match.groupValues[6].isNotEmpty()) {
+                BigInteger(match.groupValues[6].trim()) * MINUTES_PER_HOUR + BigInteger(match.groupValues[7])
+            } else BigInteger(match.groupValues[8])
+            return HarmonyOSUptimeObservation(raw, (days * MINUTES_PER_DAY + withinDay).toString())
+        }
+
+        /** Caller must bind both observations to the same explicit device and trusted command. */
+        fun requireRestarted(before: HarmonyOSUptimeObservation, after: HarmonyOSUptimeObservation) {
+            require(BigInteger(after.minutes) < BigInteger(before.minutes)) { "Uptime did not strictly decrease." }
+        }
+    }
+}
diff --git a/maestro-client/src/main/java/maestro/harmonyos/hdc/HdcClient.kt b/maestro-client/src/main/java/maestro/harmonyos/hdc/HdcClient.kt
new file mode 100644
index 0000000..7aa89ba
--- /dev/null
+++ b/maestro-client/src/main/java/maestro/harmonyos/hdc/HdcClient.kt
@@ -0,0 +1,211 @@
+package maestro.harmonyos.hdc
+
+import java.nio.file.Path
+import java.time.Duration
+
+class HdcCommandException(val result: HdcCommandResult, val confirmedRemoteExitCode: Int? = null) :
+    HdcException("HDC command failed (exit ${result.exitCode}): ${diagnostic(result)}") {
+    companion object {
+        private fun diagnostic(result: HdcCommandResult): String =
+            result.stderr.ifBlank { result.stdout }.trim().take(2048)
+    }
+}
+
+class HdcDeviceSelectionException(message: String) : HdcException(message)
+
+/** Host transport only; shell command availability must be checked on the target device. */
+class HdcClient(
+    private val executablePath: String = defaultExecutable(),
+    private val runner: HdcCommandRunner = ProcessHdcCommandRunner(),
+    private val commandTimeout: Duration = Duration.ofSeconds(10),
+    private val recoveryJournal: HarmonyOSRecoveryJournal? = null,
+    private val resourceRecovery: Boolean = false,
+) {
+    init {
+        require(executablePath.isNotBlank() && '\u0000' !in executablePath) { "A valid HDC executable is required" }
+        require(!commandTimeout.isZero && !commandTimeout.isNegative) { "Timeout must be positive" }
+    }
+
+    fun withRecoveryJournal(journal: HarmonyOSRecoveryJournal): HdcClient =
+        HdcClient(executablePath, runner, commandTimeout, journal)
+
+    internal fun forResourceRecovery(journal: HarmonyOSRecoveryJournal): HdcClient =
+        HdcClient(executablePath, runner, commandTimeout, journal, resourceRecovery = true)
+
+    internal fun recordingResources(): HarmonyOSRecoveryJournal? = recoveryJournal
+
+    internal fun allocateTemporaryFile(kind: String, extension: String): String =
+        recoveryJournal?.allocateTemporaryFile(kind, extension)
+            ?: "/data/local/tmp/maestro-$kind-${java.util.UUID.randomUUID()}.$extension"
+
+    internal fun forgetTemporaryFile(path: String) { recoveryJournal?.forgetTemporaryFile(path) }
+
+    fun listDevices(): List<String> {
+        val result = execute(listOf("list", "targets"), commandTimeout)
+        if (result.stderr.isNotBlank()) {
+            throw HdcException("HDC device listing returned diagnostics: ${result.stderr.trim().take(2048)}")
+        }
+        return parseDeviceList(result.stdout)
+    }
+
+    fun selectDevice(requestedId: String? = null): String {
+        if (requestedId != null) validateDeviceId(requestedId)
+        val devices = listDevices()
+        if (requestedId != null) {
+            if (requestedId !in devices) throw HdcDeviceSelectionException("The requested HDC device is not available")
+            return requestedId
+        }
+        return when (devices.size) {
+            0 -> throw HdcDeviceSelectionException("No HDC device found. Connect and authorize a device first.")
+            1 -> devices.single()
+            else -> throw HdcDeviceSelectionException("Multiple HDC devices found. Select a device explicitly.")
+        }
+    }
+
+    /**
+     * Arguments are quoted for the device shell as well as kept separate from host options.
+     * The exit code belongs to the host HDC process; callers must also check device-command results.
+     */
+    fun shell(
+        deviceId: String,
+        arguments: List<String>,
+        timeout: Duration = commandTimeout,
+    ): HdcCommandResult {
+        return shellTracked(deviceId, arguments, timeout, finiteCommand(arguments))
+    }
+
+    internal fun shellFinite(deviceId: String, arguments: List<String>, timeout: Duration, finite: Boolean): HdcCommandResult =
+        shellTracked(deviceId, arguments, timeout, finite)
+
+    private fun shellTracked(deviceId: String, arguments: List<String>, timeout: Duration, finite: Boolean): HdcCommandResult {
+        validateDeviceId(deviceId)
+        require(arguments.isNotEmpty() && arguments.first().isNotBlank()) { "A shell command is required" }
+        require(arguments.none { '\u0000' in it }) { "Shell arguments cannot contain NUL" }
+        val journal = recoveryJournal
+        if (journal != null) {
+            require(journal.deviceId == deviceId) { "Recovery journal belongs to another target." }
+            if (resourceRecovery) {
+                require(finite) { "Resource recovery accepts only declared finite commands." }
+                checkResourceRecoveryReady(journal)
+                val result = try {
+                    journal.shell(arguments, finite, allowSealed = true) { wrapped -> rawShell(deviceId, wrapped, timeout, true, allowSealed = true) }
+                } catch (error: HdcCommandException) {
+                    // An acknowledged nonzero status can be a valid absence result. It is
+                    // safe to interpret only after its native host invocation has ended.
+                    try { checkResourceRecoveryReady(journal) } catch (notReady: Exception) {
+                        notReady.addSuppressed(error)
+                        throw notReady
+                    }
+                    throw error
+                }
+                checkResourceRecoveryReady(journal)
+                return result
+            }
+            return journal.shell(arguments, finite) { wrapped -> rawShell(deviceId, wrapped, timeout, true) }
+        }
+        return rawShell(deviceId, arguments, timeout, false)
+    }
+
+    /** Recovery does not register new device work, but its native HDC processes remain tracked. */
+    internal fun shellRecovery(deviceId: String, arguments: List<String>, timeout: Duration, journal: HarmonyOSRecoveryJournal,
+                               beforeDispatch: ((String) -> Unit)? = null): HdcCommandResult {
+        validateDeviceId(deviceId)
+        require(journal.deviceId == deviceId)
+        val command = arguments.joinToString(" ", transform = ::quoteShellArgument)
+        return execute(listOf("-t", deviceId, "shell", command), timeout, true, journal, true, beforeDispatch)
+    }
+
+    private fun rawShell(deviceId: String, arguments: List<String>, timeout: Duration, trackHost: Boolean, allowSealed: Boolean = false): HdcCommandResult {
+        val command = arguments.joinToString(" ", transform = ::quoteShellArgument)
+        return execute(listOf("-t", deviceId, "shell", command), timeout, trackHost, allowSealed = allowSealed)
+    }
+
+    fun receiveFile(
+        deviceId: String,
+        remotePath: String,
+        localPath: Path,
+        timeout: Duration = commandTimeout,
+    ): HdcCommandResult {
+        validateDeviceId(deviceId)
+        require(remotePath.startsWith('/') && '\u0000' !in remotePath && '\n' !in remotePath && '\r' !in remotePath) {
+            "An absolute device file path is required"
+        }
+        recoveryJournal?.let { require(it.deviceId == deviceId) { "Recovery journal belongs to another target." } }
+        if (resourceRecovery) checkResourceRecoveryReady(checkNotNull(recoveryJournal))
+        return execute(listOf("-t", deviceId, "file", "recv", remotePath, localPath.toAbsolutePath().toString()), timeout, recoveryJournal != null, allowSealed = resourceRecovery)
+            .also { if (resourceRecovery) checkResourceRecoveryReady(checkNotNull(recoveryJournal)) }
+    }
+
+    private fun checkResourceRecoveryReady(journal: HarmonyOSRecoveryJournal) {
+        val issues = journal.snapshot().issues.filter { it.code != "OWNED_RESOURCES_REMAIN" }
+        check(issues.isEmpty()) { "Resource recovery is not quiescent: ${issues.joinToString { it.code }}" }
+    }
+
+    private fun execute(arguments: List<String>, timeout: Duration, trackHost: Boolean = false,
+        journal: HarmonyOSRecoveryJournal? = recoveryJournal, allowSealed: Boolean = false,
+        beforeDispatch: ((String) -> Unit)? = null): HdcCommandResult {
+        val command = listOf(executablePath) + arguments
+        // A maintenance binding may write to disk. Charge that work to the same command budget.
+        val deadline = if (beforeDispatch == null) null else System.nanoTime() + timeout.toNanos()
+        val result = if (trackHost && journal != null) journal.hostCall(allowSealed, beforeDispatch ?: {}) { observer ->
+            val effectiveTimeout = deadline?.let {
+                if (Thread.currentThread().isInterrupted) throw InterruptedException("Maintenance dispatch was interrupted.")
+                val remaining = it - System.nanoTime()
+                if (remaining <= 0) throw HdcTimeoutException(timeout)
+                Duration.ofNanos(remaining)
+            } ?: timeout
+            if (runner is ProcessHdcCommandRunner) runner.runObserved(command, effectiveTimeout, observer) else runner.run(command, effectiveTimeout)
+        } else runner.run(command, timeout)
+        if (result.exitCode != 0 || hasHdcFailure(result.stdout) || hasHdcFailure(result.stderr)) {
+            throw HdcCommandException(result)
+        }
+        return result
+    }
+
+    companion object {
+        internal fun finiteCommand(arguments: List<String>): Boolean =
+            (arguments.firstOrNull() == "uitest" && arguments.getOrNull(1) in setOf("dumpLayout", "screenCap", "uiInput")) ||
+                (arguments.firstOrNull() == "aa" && arguments.getOrNull(1) in setOf("start", "force-stop")) ||
+                (arguments.take(2) == listOf("rm", "-f") && arguments.size == 3) ||
+                (arguments == listOf("ps", "-ef")) ||
+                (arguments == listOf("hidumper", "-s", "3002", "-a", "-h")) ||
+                (arguments == listOf("bm", "dump", "-n", "com.huawei.hmos.screenrecorder")) ||
+                (arguments.take(3) == listOf("stat", "-c", "%s") && arguments.size == 4 && recordingScratch(arguments[3])) ||
+                (arguments.size == 3 && arguments[0] == "test" && arguments[1] in setOf("-L", "-e", "-f") && recordingScratch(arguments[2])) ||
+                (arguments.take(2) == listOf("mediatool", "query") && arguments.size == 4 &&
+                    arguments[2].matches(Regex("maestro-recording-[0-9a-f]{32}\\.mp4")) && arguments[3] == "-u") ||
+                (arguments.take(2) == listOf("mediatool", "delete") && arguments.size == 3 && recordingMedia(arguments[2])) ||
+                (arguments.take(2) == listOf("mediatool", "recv") && arguments.size == 4 && recordingMedia(arguments[2]) && recordingScratch(arguments[3]))
+
+        private fun recordingScratch(value: String) = value.matches(Regex("/data/local/tmp/maestro-session-[0-9a-f-]{36}/files/recording-[0-9a-f-]{36}\\.mp4"))
+        private fun recordingMedia(value: String) = value.matches(Regex("file://media/Photo/[0-9]+/[A-Za-z0-9_.-]+/maestro-recording-[0-9a-f]{32}\\.mp4"))
+        private val deviceIdPattern = Regex("[A-Za-z0-9][A-Za-z0-9._:-]*")
+        private val diagnosticTokens = setOf("error", "fail", "failed", "failure", "warning", "warn", "usage", "help", "hdc")
+        private val hdcFailurePattern = Regex("(?im)^\\s*(?:\\[\\s*(?:fail|error)\\s*]|error:|failed:)")
+
+        private fun defaultExecutable(): String = System.getenv("MAESTRO_HARMONYOS_HDC")
+            ?.takeIf { it.isNotBlank() } ?: "hdc"
+
+        private fun hasHdcFailure(output: String): Boolean = hdcFailurePattern.containsMatchIn(output)
+
+        internal fun parseDeviceList(output: String): List<String> {
+            val lines = output.lineSequence().map { it.trim() }.filter { it.isNotEmpty() }.toList()
+            if (lines.isEmpty() || lines == listOf("[Empty]")) return emptyList()
+            if (lines.any { !deviceIdPattern.matches(it) || it.lowercase() in diagnosticTokens }) {
+                throw HdcException("Unexpected HDC device-list output; no device was selected")
+            }
+            return lines.distinct()
+        }
+
+        private fun validateDeviceId(deviceId: String) {
+            require(deviceIdPattern.matches(deviceId) && deviceId.lowercase() !in diagnosticTokens) {
+                "Invalid HDC device identifier"
+            }
+        }
+
+        internal fun quoteShellArgument(value: String): String {
+            require('\u0000' !in value) { "Shell arguments cannot contain NUL" }
+            return "'" + value.replace("'", "'\"'\"'") + "'"
+        }
+    }
+}
diff --git a/maestro-client/src/main/java/maestro/harmonyos/hdc/HdcCommandRunner.kt b/maestro-client/src/main/java/maestro/harmonyos/hdc/HdcCommandRunner.kt
new file mode 100644
index 0000000..bff79c8
--- /dev/null
+++ b/maestro-client/src/main/java/maestro/harmonyos/hdc/HdcCommandRunner.kt
@@ -0,0 +1,181 @@
+package maestro.harmonyos.hdc
+
+import java.io.ByteArrayOutputStream
+import java.io.IOException
+import java.io.InputStream
+import java.time.Duration
+import java.util.concurrent.ExecutionException
+import java.util.concurrent.Executors
+import java.util.concurrent.Future
+import java.util.concurrent.TimeUnit
+import java.util.concurrent.TimeoutException
+
+data class HdcCommandResult(val exitCode: Int, val stdout: String, val stderr: String)
+
+fun interface HdcCommandRunner {
+    fun run(command: List<String>, timeout: Duration): HdcCommandResult
+}
+
+open class HdcException(message: String, cause: Throwable? = null) : RuntimeException(message, cause)
+
+class HdcTimeoutException(val timeout: Duration) : HdcException("HDC command exceeded ${timeout.toMillis()} ms")
+
+class HdcOutputLimitException(stream: String, limit: Int) :
+    HdcException("HDC $stream exceeded the $limit byte output limit")
+
+/** Runs one finite command. Each output stream has its own memory limit. */
+class ProcessHdcCommandRunner(private val maxOutputBytes: Int = 4 * 1024 * 1024) : HdcCommandRunner {
+
+    init {
+        require(maxOutputBytes > 0) { "Output limit must be positive" }
+    }
+
+    override fun run(command: List<String>, timeout: Duration): HdcCommandResult = runObserved(command, timeout) {}
+
+    internal fun runObserved(command: List<String>, timeout: Duration, observer: (HarmonyOSRecoveryJournal.HostProcess) -> Unit): HdcCommandResult {
+        require(command.isNotEmpty() && command.first().isNotBlank()) { "An executable is required" }
+        require(command.none { '\u0000' in it }) { "Command arguments cannot contain NUL" }
+        require(!timeout.isZero && !timeout.isNegative) { "Timeout must be positive" }
+        val timeoutNanos = timeout.toNanos()
+        val deadline = System.nanoTime() + timeoutNanos
+        val process = try {
+            ProcessBuilder(processArguments(command)).start()
+        } catch (e: IOException) {
+            throw HdcException("Unable to start HDC executable: ${command.first()}", e)
+        }
+        val rootIdentity = HarmonyOSRecoveryJournal.HostProcess(process.pid(), runCatching { process.info().startInstant().orElse(null)?.toString() }.getOrNull())
+        val processTree = OwnedProcessTree(rootIdentity)
+        val readers = Executors.newFixedThreadPool(2) { task ->
+            Thread(task, "maestro-hdc-output").apply { isDaemon = true }
+        }
+        try {
+            observer(rootIdentity)
+            // Finite commands must not wait for keyboard input.
+            process.outputStream.close()
+            val stdout = readers.submit<String> { readOutput(process.inputStream, "stdout") }
+            val stderr = readers.submit<String> { readOutput(process.errorStream, "stderr") }
+            while (true) {
+                processTree.refresh()
+                processTree.identities().forEach(observer)
+                checkReader(stdout)
+                checkReader(stderr)
+                val remaining = remainingNanos(deadline, timeout)
+                if (process.waitFor(minOf(remaining, TimeUnit.MILLISECONDS.toNanos(25)), TimeUnit.NANOSECONDS)) {
+                    break
+                }
+            }
+            return HdcCommandResult(
+                process.exitValue(),
+                awaitOutput(stdout, deadline, timeout),
+                awaitOutput(stderr, deadline, timeout),
+            )
+        } catch (e: InterruptedException) {
+            terminate(processTree, observer)
+            Thread.currentThread().interrupt()
+            throw e
+        } catch (e: Throwable) {
+            terminate(processTree, observer)
+            throw e
+        } finally {
+            readers.shutdownNow()
+            runCatching { process.inputStream.close() }
+            runCatching { process.errorStream.close() }
+            runCatching { process.outputStream.close() }
+        }
+    }
+
+    private fun readOutput(stream: InputStream, name: String): String {
+        val output = ByteArrayOutputStream(minOf(maxOutputBytes, 8192))
+        val buffer = ByteArray(8192)
+        while (true) {
+            val count = stream.read(buffer)
+            if (count < 0) break
+            if (count > maxOutputBytes - output.size()) throw HdcOutputLimitException(name, maxOutputBytes)
+            output.write(buffer, 0, count)
+        }
+        return output.toString(Charsets.UTF_8)
+    }
+
+    @Suppress("DEPRECATION")
+    private fun processArguments(command: List<String>): List<String> {
+        if (!System.getProperty("os.name").startsWith("Windows")) return command
+        val executable = command.first()
+        require('"' !in executable) { "Pass the Windows executable path without surrounding quotes" }
+        require(!executable.endsWith(".cmd", true) && !executable.endsWith(".bat", true)) {
+            "HDC must be a native executable, not a Windows command script"
+        }
+        val securityManager = System.getSecurityManager()
+        val ambiguousCommands = System.getProperty(
+            "jdk.lang.Process.allowAmbiguousCommands", if (securityManager == null) "true" else "false",
+        )
+        if (ambiguousCommands.equals("false", ignoreCase = true)) {
+            // The JDK escapes embedded quotes in strict mode, but interprets a leading/trailing
+            // quote pair as caller-supplied quoting and would silently strip literal quotes.
+            require(command.drop(1).none { it.length >= 2 && it.startsWith('"') && it.endsWith('"') }) {
+                "This JDK Windows strict quoting mode cannot preserve an argument enclosed in literal double quotes"
+            }
+            return command
+        }
+        require(securityManager == null) { "Legacy Windows argument quoting with a SecurityManager is not supported" }
+
+        // JDK 17's default Windows mode does not escape embedded quotes. Encode complete CRT
+        // arguments here; ProcessImpl preserves these outer-quoted strings without re-encoding.
+        return listOf(executable) + command.drop(1).map(::quoteWindowsArgument)
+    }
+
+    private fun quoteWindowsArgument(value: String): String = buildString {
+        append('"')
+        var backslashes = 0
+        value.forEach { character ->
+            if (character == '\\') {
+                backslashes++
+            } else {
+                repeat(if (character == '"') backslashes * 2 + 1 else backslashes) { append('\\') }
+                append(character)
+                backslashes = 0
+            }
+        }
+        // Backslashes immediately before the closing quote must be doubled.
+        repeat(backslashes * 2) { append('\\') }
+        append('"')
+    }
+
+    private fun checkReader(reader: Future<String>) {
+        if (reader.isDone) unwrap { reader.get() }
+    }
+
+    private fun awaitOutput(reader: Future<String>, deadline: Long, timeout: Duration): String = try {
+        unwrap { reader.get(remainingNanos(deadline, timeout), TimeUnit.NANOSECONDS) }
+    } catch (_: TimeoutException) {
+        throw HdcTimeoutException(timeout)
+    }
+
+    private fun <T> unwrap(action: () -> T): T = try {
+        action()
+    } catch (e: ExecutionException) {
+        val cause = e.cause
+        if (cause is HdcException) throw cause
+        throw HdcException("Unable to read HDC command output", cause ?: e)
+    }
+
+    private fun remainingNanos(deadline: Long, timeout: Duration): Long {
+        val remaining = deadline - System.nanoTime()
+        if (remaining <= 0) throw HdcTimeoutException(timeout)
+        return remaining
+    }
+
+    private fun terminate(processTree: OwnedProcessTree, observer: (HarmonyOSRecoveryJournal.HostProcess) -> Unit) {
+        runCatching { processTree.refresh() }
+        processTree.identities().forEach { identity -> runCatching { observer(identity) } }
+        processTree.terminate()
+        // destroyForcibly requests termination; it is not an exit acknowledgement. Recovery
+        // also retains native identities when a process does not finish within this allowance.
+        var interrupted = Thread.interrupted()
+        try {
+            val deadline = System.nanoTime() + TimeUnit.SECONDS.toNanos(5)
+            while (processTree.hasUnconfirmedProcesses() && System.nanoTime() < deadline) {
+                try { Thread.sleep(10) } catch (_: InterruptedException) { interrupted = true }
+            }
+        } finally { if (interrupted) Thread.currentThread().interrupt() }
+    }
+}
diff --git a/maestro-client/src/main/java/maestro/harmonyos/hdc/OwnedProcessTree.kt b/maestro-client/src/main/java/maestro/harmonyos/hdc/OwnedProcessTree.kt
new file mode 100644
index 0000000..a733559
--- /dev/null
+++ b/maestro-client/src/main/java/maestro/harmonyos/hdc/OwnedProcessTree.kt
@@ -0,0 +1,102 @@
+package maestro.harmonyos.hdc
+
+import maestro.harmonyos.hdc.HarmonyOSRecoveryJournal.HostProcess
+import java.time.Instant
+
+internal data class NativeProcessSnapshot(val identity: HostProcess, val parent: HostProcess?)
+
+internal interface NativeProcessAccess {
+    fun snapshot(pid: Long): NativeProcessSnapshot?
+    fun children(pid: Long): List<Long>
+    /** Must recheck the immutable identity immediately before requesting termination. */
+    fun destroyIfMatches(identity: HostProcess)
+}
+
+internal object SystemNativeProcessAccess : NativeProcessAccess {
+    private fun readIdentity(process: ProcessHandle) = HostProcess(process.pid(), process.info().startInstant().orElse(null)?.toString())
+    override fun snapshot(pid: Long): NativeProcessSnapshot? {
+        val process = ProcessHandle.of(pid).orElse(null) ?: return null
+        if (!process.isAlive) return null
+        return NativeProcessSnapshot(readIdentity(process), process.parent().orElse(null)?.let(::readIdentity))
+    }
+    override fun children(pid: Long): List<Long> {
+        val process = ProcessHandle.of(pid).orElse(null) ?: return emptyList()
+        return process.children().use { stream -> stream.map { it.pid() }.toList() }
+    }
+    override fun destroyIfMatches(identity: HostProcess) {
+        if (identity.startedAt == null) return
+        val process = ProcessHandle.of(identity.pid).orElse(null) ?: return
+        if (readIdentity(process) == identity) process.destroyForcibly()
+    }
+}
+
+/** PPID values survive their original parent on Windows. Every edge needs both process identities. */
+internal class OwnedProcessTree(
+    private val root: HostProcess,
+    private val access: NativeProcessAccess = SystemNativeProcessAccess,
+) {
+    private val observed = linkedSetOf(root)
+
+    fun identities(): List<HostProcess> = observed.toList()
+
+    fun refresh() {
+        val queue = ArrayDeque(observed.filter { it.startedAt != null })
+        val visited = mutableSetOf<HostProcess>()
+        while (queue.isNotEmpty()) {
+            val owner = queue.removeFirst()
+            if (!visited.add(owner)) continue
+            val currentOwner = try { access.snapshot(owner.pid) } catch (_: Exception) {
+                observed += HostProcess(owner.pid, null)
+                continue
+            }
+            if (currentOwner != null && currentOwner.identity.startedAt == null) observed += HostProcess(owner.pid, null)
+            if (currentOwner?.identity != owner) continue
+            val children = try { access.children(owner.pid) } catch (_: Exception) {
+                observed += HostProcess(owner.pid, null)
+                continue
+            }
+            for (pid in children) {
+                val child = try { access.snapshot(pid) } catch (_: Exception) {
+                    observed += HostProcess(pid, null)
+                    continue
+                } ?: continue
+                val started = child.identity.startedAt
+                val ownerStarted = checkNotNull(owner.startedAt)
+                // An older process cannot have been created by this instance of its alleged parent.
+                if (started != null && Instant.parse(started) < Instant.parse(ownerStarted)) continue
+                if (child.parent?.pid != owner.pid) {
+                    if (child.parent == null) observed += HostProcess(pid, null)
+                    continue
+                }
+                if (started == null || child.parent.startedAt == null) {
+                    observed += HostProcess(pid, null)
+                    continue
+                }
+                if (child.parent != owner) continue
+                val recheckedOwner = try { access.snapshot(owner.pid) } catch (_: Exception) {
+                    observed += HostProcess(owner.pid, null)
+                    continue
+                }
+                if (recheckedOwner?.identity != owner) {
+                    if (recheckedOwner != null && recheckedOwner.identity.startedAt == null) observed += HostProcess(owner.pid, null)
+                    continue
+                }
+                if (observed.add(child.identity)) queue.addLast(child.identity)
+            }
+        }
+    }
+
+    fun terminate() {
+        observed.toList().asReversed().forEach { identity ->
+            if (identity.startedAt != null) runCatching { access.destroyIfMatches(identity) }
+        }
+    }
+
+    fun hasUnconfirmedProcesses(): Boolean = observed.any { identity ->
+        runCatching {
+            access.snapshot(identity.pid)?.identity?.let { current ->
+                identity.startedAt == null || current.startedAt == null || current == identity
+            } == true
+        }.getOrDefault(true)
+    }
+}
