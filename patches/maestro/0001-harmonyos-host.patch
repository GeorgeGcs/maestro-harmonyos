+            val columns = line.split(Regex("\\s+"), limit = 8)
+            check(columns.size == 8) { "Recorder process status is incomplete." }
+            if (columns[7] == "com.huawei.hmos.screenrecorder" || columns[7].startsWith("com.huawei.hmos.screenrecorder:")) {
