+            journal.seal()
+            val noProof = HdcClient("fake", HdcCommandRunner { _, _ -> HdcCommandResult(0, "", "") })
+            assertThat(journal.recover(noProof).issues.map { it.code }).contains("REMOTE_COMPLETION_UNCONFIRMED")
